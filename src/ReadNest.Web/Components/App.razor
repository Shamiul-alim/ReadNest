<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="ReadNest - your personal book library, reading tracker and knowledge journal." />
    <meta name="theme-color" content="#f5ead8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1c18" media="(prefers-color-scheme: dark)" />
    <base href="/" />
    @* Applies the saved theme before the stylesheet paints, so Lamplight never flashes paper. *@
    <script>
        (function () { try { var t = localStorage.getItem("rn-theme"); if (t === "light" || t === "dark") { document.documentElement.setAttribute("data-theme", t); } } catch (e) { } })();
    </script>
    <ResourcePreloader />
    <link rel="preload" href="fonts/caprasimo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["ReadNest.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="images/logo.svg" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>
