@page "/Account/ForgotPasswordConfirmation"

@using Microsoft.AspNetCore.Identity
@using ReadNest.Infrastructure.Identity
@inject IEmailSender<ApplicationUser> EmailSender

<PageTitle>Check your email · ReadNest</PageTitle>

<div style="display:flex; flex-direction:column; gap:8px">
    <h1>Check your email</h1>
    <p class="rn-auth-sub">If an account uses that address, a reset link is on its way.</p>
</div>
@if (EmailSender is IdentityNoOpEmailSender)
{
    <div class="rn-alert rn-alert-info" role="status">
        <Icon Name="info" />
        <span>This server can’t send email yet, so no link was sent. If you run this server, configure an email sender and try again.</span>
    </div>
}
else
{
    <div class="rn-alert rn-alert-success" role="status">
        <Icon Name="mail" />
        <span>Didn’t get it after a few minutes? Check your spam folder, or try again.</span>
    </div>
}
<a class="rn-btn rn-btn-primary rn-btn-block" style="min-height:50px; font-size:16px" href="Account/Login">Back to sign in</a>
