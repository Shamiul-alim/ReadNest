@page "/Account/ExternalLogin"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ReadNest.Infrastructure.Identity
@using ReadNest.Web.Configuration

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger
@inject ReadNest.Application.Social.ProfileService Profiles

<PageTitle>@(_state == PageState.ExistingAccount ? "Sign in to connect Google" : "Finish signing up") · ReadNest</PageTitle>

@if (_state == PageState.ExistingAccount)
{
    <div style="display:flex; flex-direction:column; gap:8px">
        <h1>You already have an account</h1>
        <p class="rn-auth-sub">
            <strong>@_email</strong> is already registered with ReadNest. For your security we don't connect a Google
            sign-in to an existing account automatically.
        </p>
    </div>
    <ol class="rn-numbered">
        <li>Sign in with your email and password.</li>
        <li>Open <strong>Settings → Account → Connected sign-ins</strong> and choose <strong>Connect Google</strong>.</li>
        <li>From then on, “Continue with Google” signs you straight in.</li>
    </ol>
    <a class="rn-btn rn-btn-primary rn-btn-block" style="min-height:50px; font-size:16px" href="Account/Login">Sign in with email</a>
    <p class="rn-subtle rn-mb-0">Forgot your password? <a href="Account/ForgotPassword">Reset it</a>.</p>
}
else if (_state == PageState.Confirm)
{
    <div style="display:flex; flex-direction:column; gap:8px">
        <h1>Finish signing up</h1>
        <p class="rn-auth-sub">You're signing up with your Google account. Choose the name other readers will see.</p>
    </div>
    <StatusMessage Message="@_message" />
    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="external-confirmation" method="post" class="rn-form" novalidate>
        <DataAnnotationsValidator />
        <div class="rn-field">
            <span class="rn-label">Google account</span>
            <div class="rn-google-identity"><GoogleMark /><span>@_email</span></div>
            <span class="rn-hint">Your ReadNest account uses this address. It comes from Google and can't be changed here.</span>
        </div>
        <div class="rn-field">
            <label for="Input.DisplayName" class="rn-label">Your name</label>
            <InputText @bind-Value="Input.DisplayName" id="Input.DisplayName" class="rn-input" autocomplete="name" aria-required="true" />
            <ValidationMessage For="() => Input.DisplayName" />
        </div>
        <input type="hidden" name="Input.TimeZone" value="@Input.TimeZone" data-timezone />
        <button type="submit" class="rn-btn rn-btn-primary rn-btn-block" style="min-height:50px; font-size:16px">Create my library</button>
    </EditForm>
    <div class="rn-auth-alt">
        <span>Not you?</span>
        <a href="Account/Login">Use a different account</a>
    </div>
}

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private enum PageState
    {
        Redirecting,
        Confirm,
        ExistingAccount,
    }

    private PageState _state = PageState.Redirecting;
    private string? _message;
    private string? _email;
    private ExternalLoginInfo? _info;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    private string Destination => string.IsNullOrEmpty(ReturnUrl) ? "dashboard" : ReturnUrl;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (RemoteError is not null)
        {
            Logger.LogWarning("External login returned an error.");
            ToLogin("failed");
            return;
        }

        _info = await SignInManager.GetExternalLoginInfoAsync();
        if (_info is null)
        {
            ToLogin("expired");
            return;
        }

        // The email always comes from the provider's verified identity, never from the form.
        _email = _info.Principal.FindFirstValue(ClaimTypes.Email)?.Trim();
        if (string.IsNullOrEmpty(_email))
        {
            ToLogin("no-email");
            return;
        }

        if (string.Equals(_info.Principal.FindFirstValue(GoogleAuthentication.EmailVerifiedClaim), "false", StringComparison.OrdinalIgnoreCase))
        {
            ToLogin("unverified");
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnLoginCallbackAsync();
                return;
            }

            // This page is only reached through the provider callback.
            RedirectManager.RedirectTo("Account/Login");
            return;
        }

        // Form post: re-check that nobody registered this address in the meantime.
        _state = await UserManager.FindByEmailAsync(_email) is null ? PageState.Confirm : PageState.ExistingAccount;
    }

    private async Task OnLoginCallbackAsync()
    {
        // An account that has already connected this Google identity signs straight in.
        var result = await SignInManager.ExternalLoginSignInAsync(_info!.LoginProvider, _info.ProviderKey, isPersistent: false, bypassTwoFactor: true);
        if (result.Succeeded)
        {
            Logger.LogInformation("User signed in with {LoginProvider}.", _info.LoginProvider);
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
            RedirectManager.RedirectTo(Destination);
            return;
        }

        if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
            return;
        }

        if (result.IsNotAllowed)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Error: Confirm your email address before signing in.", HttpContext);
            return;
        }

        // No connected account. An existing account with the same email is never linked automatically: the owner
        // must sign in and connect Google from their account settings.
        if (await UserManager.FindByEmailAsync(_email!) is not null)
        {
            _state = PageState.ExistingAccount;
            return;
        }

        Input.DisplayName = SuggestedName(_info.Principal, _email!);
        _state = PageState.Confirm;
    }

    private async Task OnValidSubmitAsync()
    {
        if (_info is null || _email is null || _state != PageState.Confirm)
        {
            return;
        }

        var user = new ApplicationUser();
        await UserStore.SetUserNameAsync(user, _email, CancellationToken.None);
        await ((IUserEmailStore<ApplicationUser>)UserStore).SetEmailAsync(user, _email, CancellationToken.None);

        // Google only signs in accounts whose address it has verified (checked above).
        user.EmailConfirmed = true;

        var result = await UserManager.CreateAsync(user);
        if (result.Succeeded)
        {
            result = await UserManager.AddLoginAsync(user, _info);
            if (!result.Succeeded)
            {
                await UserManager.DeleteAsync(user);
            }
        }

        if (!result.Succeeded)
        {
            _message = result.Errors.Any(e => e.Code is "DuplicateEmail" or "DuplicateUserName" or "LoginAlreadyAssociated")
                ? "Error: An account with this email or Google login already exists. Sign in instead."
                : "Error: We couldn't create your account. Please try again.";
            return;
        }

        Logger.LogInformation("User created an account using {LoginProvider}.", _info.LoginProvider);
        await Profiles.GetOrCreateAsync(user.Id, Input.DisplayName, Input.TimeZone, CancellationToken.None);
        await SignInManager.SignInAsync(user, isPersistent: false, _info.LoginProvider);
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        RedirectManager.RedirectTo(Destination);
    }

    private void ToLogin(string reason) =>
        RedirectManager.RedirectTo("Account/Login", new() { ["external"] = reason, ["ReturnUrl"] = ReturnUrl });

    private static string SuggestedName(ClaimsPrincipal principal, string email)
    {
        var name = principal.FindFirstValue(ClaimTypes.Name) ?? principal.FindFirstValue(ClaimTypes.GivenName) ?? email.Split('@')[0];
        name = name.Trim();
        return name.Length > 80 ? name[..80] : name;
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(80, MinimumLength = 1)]
        [Display(Name = "Your name")]
        public string DisplayName { get; set; } = "";

        [StringLength(64)]
        public string? TimeZone { get; set; }
    }
}
