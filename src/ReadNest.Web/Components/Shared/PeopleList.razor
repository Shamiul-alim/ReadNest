@using ReadNest.Application.Social
@if (People.Count == 0)
{
    <p class="rn-subtle mt-2 rn-mb-0">@Empty</p>
}
else
{
    <div class="rn-list mt-2">
        @foreach (var person in People)
        {
            <div class="rn-list-item" @key="person">
                <Avatar Name="@person.DisplayName" ImageUrl="@person.ProfileImageUrl" Size="md" />
                <div class="rn-list-body">
                    @if (person.IsPublic)
                    {
                        <a class="rn-list-title" href="@("u/" + person.Handle)">@person.DisplayName</a>
                    }
                    else
                    {
                        <span class="rn-list-title">@person.DisplayName</span> <span class="rn-chip"><Icon Name="lock" /> Private</span>
                    }
                    <div class="rn-subtle">@@@person.Handle</div>
                    @if (!string.IsNullOrEmpty(person.Bio))
                    {
                        <div class="rn-muted rn-truncate">@person.Bio</div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PersonDto> People { get; set; } = [];
    [Parameter] public string Empty { get; set; } = "Nobody here yet.";
}
