@using ReadNest.Application.Social
<div class="rn-grid" style="grid-template-columns:repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap:16px">
    @foreach (var challenge in Challenges)
    {
        <ChallengeCard Challenge="challenge" Today="Today" @key="challenge.Id" />
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChallengeSummaryDto> Challenges { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
}
