@if (Value is { } value)
{
    <span class="rn-stars" role="img" aria-label="@("Rated " + value + " out of 5")">
        @for (var i = 1; i <= 5; i++)
        {
            <span class="@(i <= value ? "on" : "off")"><Icon Name="star" /></span>
        }
    </span>
}
else if (ShowEmpty)
{
    <span class="rn-subtle">Not rated</span>
}

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public bool ShowEmpty { get; set; }
}
