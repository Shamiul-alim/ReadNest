@implements IAsyncDisposable
@inject IJSRuntime JS

@* Accessible modal built on the native <dialog> element: focus is trapped by the browser, Escape closes it,
   and the page behind becomes inert. *@
@if (Open)
{
    <dialog @ref="_dialog" class="rn-dialog @(Wide ? "wide" : null)" aria-labelledby="@_titleId">
        <div class="rn-dialog-header">
            <h2 id="@_titleId">@Title</h2>
            <button type="button" class="rn-btn rn-btn-ghost rn-btn-icon" aria-label="Close dialog" @onclick="CloseAsync"><Icon Name="x" /></button>
        </div>
        <div class="rn-dialog-body">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="rn-dialog-footer">@Footer</div>
        }
    </dialog>
}

@code {
    private readonly string _titleId = "dlg-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _dialog;
    private DotNetObjectReference<Modal>? _self;
    private bool _shown;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _shown = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_shown)
        {
            _shown = true;
            _self ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("readnest.showDialog", _dialog, _self);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public Task OnDialogCancelled() => InvokeAsync(CloseAsync);

    public async Task CloseAsync()
    {
        Open = false;
        _shown = false;
        await OpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _self?.Dispose();
        return ValueTask.CompletedTask;
    }
}
