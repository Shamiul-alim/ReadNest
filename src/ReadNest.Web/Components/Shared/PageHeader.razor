<header class="rn-page-header">
    <div>
        @if (Breadcrumbs is not null)
        {
            <nav class="rn-breadcrumb" aria-label="Breadcrumb">@Breadcrumbs</nav>
        }
        <h1 tabindex="-1">@Title</h1>
        @if (!string.IsNullOrEmpty(Description))
        {
            <p>@Description</p>
        }
        @ChildContent
    </div>
    @if (Actions is not null)
    {
        <div class="rn-page-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Breadcrumbs { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
