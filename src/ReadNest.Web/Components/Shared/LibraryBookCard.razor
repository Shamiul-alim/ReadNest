@using ReadNest.Application.Library
@* Grid book card: cover, title, author, status label, then progress (reading) or stars (rated).
   Always five rows so the parent grid's subgrid keeps every row aligned. *@
<article class="rn-book-card" role="listitem">
    <a class="rn-cover-button" href="@Href" tabindex="-1" aria-hidden="true">
        @if (Entry.IsFavorite)
        {
            <span class="rn-fav-flag" title="Favourite"><Icon Name="heart" /></span>
        }
        <BookCover Title="@Entry.Title" Author="@FirstAuthor" Url="@Entry.CoverUrl" Isbn="@Entry.Isbn13" />
    </a>
    <h3 class="rn-book-title" title="@Entry.Title"><a href="@Href" aria-label="@AriaLabel">@Entry.Title</a></h3>
    <p class="rn-book-author" title="@AuthorsText">@AuthorsText</p>
    <div style="padding-top:var(--space-3); display:flex; align-items:center; min-width:0">
        @if (ShowStatus)
        {
            <StatusBadge Status="Entry.Status" />
        }
        @if (HasFile)
        {
            <a class="rn-file-flag" href="@("reader/" + Entry.Id)" title="Read your copy in ReadNest" aria-label="@("Read " + Entry.Title + " in ReadNest")"><Icon Name="book-open" Size="14" /></a>
        }
    </div>
    <div class="rn-book-foot" style="padding-top:var(--space-2)">
        @if (Entry.Status is ReadingStatus.CurrentlyReading or ReadingStatus.Paused && Entry.ProgressPercent is { } percent)
        {
            <div class="rn-book-card-progress" aria-label="@(ProgressBar.Format(percent) + " read")">
                <ProgressBar CurrentPage="Entry.CurrentPage" TotalPages="Entry.TotalPages" ShowLabel="false" Size="sm" />
                <span>@ProgressBar.Format(percent)</span>
            </div>
        }
        else if (Entry.Rating is not null)
        {
            <Stars Value="Entry.Rating" IconSize="14" />
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public LibraryEntryDto Entry { get; set; } = default!;
    [Parameter] public bool ShowStatus { get; set; } = true;

    /// <summary>The entry has a PDF or EPUB attached that can be opened in the reader.</summary>
    [Parameter] public bool HasFile { get; set; }

    private string Href => "books/" + Entry.BookId;
    private string? FirstAuthor => Entry.Authors.Count > 0 ? Entry.Authors[0] : null;
    private string AuthorsText => Entry.Authors.Count > 0 ? string.Join(", ", Entry.Authors) : "Unknown author";
    private string AriaLabel => "Open " + Entry.Title + " by " + AuthorsText;
}
