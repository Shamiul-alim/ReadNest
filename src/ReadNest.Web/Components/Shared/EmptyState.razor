@* Icon circle, Caprasimo heading, one explanatory sentence, one primary action. *@
<div class="rn-empty @Variant">
    @if (!string.IsNullOrEmpty(IconName))
    {
        <span class="rn-icon-circle lg @Tone"><Icon Name="@IconName" /></span>
    }
    @if (Level == 1)
    {
        <h1>@Title</h1>
    }
    else
    {
        <h2>@Title</h2>
    }
    @if (!string.IsNullOrEmpty(Text))
    {
        <p>@Text</p>
    }
    @if (ChildContent is not null)
    {
        <div class="rn-actions" style="padding-top:6px">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? IconName { get; set; } = "book";

    /// <summary>"" (sand panel), "dashed" or "plain".</summary>
    [Parameter] public string Variant { get; set; } = "";

    /// <summary>Icon circle tone: "" (clay), "sage" or "neutral".</summary>
    [Parameter] public string Tone { get; set; } = "sage";
    [Parameter] public int Level { get; set; } = 2;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
