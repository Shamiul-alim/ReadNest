@* 44px targets; choosing the same star again clears the rating. *@
<div class="rn-star-input" role="group" aria-label="@Label">
    @for (var i = 1; i <= 5; i++)
    {
        var star = i;
        <button type="button" aria-pressed="@(Value >= star ? "true" : "false")" aria-label="@(star + (star == 1 ? " star" : " stars"))"
                class="@(Value >= star ? "on" : null)" disabled="@Disabled" @onclick="() => SetAsync(Value == star && AllowClear ? null : star)">
            <Icon Name="@(Value >= star ? "star-filled" : "star")" />
        </button>
    }
    @if (ShowText)
    {
        <span class="rn-subtle" style="padding-left:6px">@Describe(Value)</span>
    }
</div>

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Your rating";
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowText { get; set; } = true;

    public static string Describe(int? value) => value switch
    {
        null => "Not rated yet",
        1 => "1 of 5 · Not for me",
        2 => "2 of 5 · It was fine",
        3 => "3 of 5 · Liked it",
        4 => "4 of 5 · Really liked it",
        _ => "5 of 5 · Loved it",
    };

    private async Task SetAsync(int? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
