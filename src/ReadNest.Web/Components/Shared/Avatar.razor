@using System.Text.RegularExpressions
<span class="rn-avatar @Size" aria-hidden="true">
    <span class="rn-avatar-initials">@InitialsFor(Name)</span>
    @if (SafeUrl is not null)
    {
        @* If the image fails to load (removed, private or offline), app.js hides it and the initials show through. *@
        <img src="@SafeUrl" alt="" referrerpolicy="no-referrer" loading="lazy" />
    }
</span>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>"" (30px), "md" (48px), "lg" (80px) or "xl" (profile hero).</summary>
    [Parameter] public string? Size { get; set; }

    private string? SafeUrl => SafeImageUrl(ImageUrl);

    /// <summary>
    /// The image URL to render: an uploaded photo served by ReadNest (relative, fixed shape) or a safe external
    /// http(s) link. Anything else is dropped and the initials are shown.
    /// </summary>
    public static string? SafeImageUrl(string? url) =>
        url is not null && OwnPhotoUrl().IsMatch(url) ? url : InputSanitizer.SafeExternalUrl(url);

    /// <summary>Up to two initials from a display name ("Elena Ferris" gives "EF").</summary>
    public static string InitialsFor(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "R",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }

    private static Regex OwnPhotoUrl() => OwnPhotoRegex;

    private static readonly Regex OwnPhotoRegex = new(@"^api/v1/users/[0-9a-f]{32}/photo\?v=[0-9]{1,20}$", RegexOptions.CultureInvariant, TimeSpan.FromMilliseconds(100));
}
