@page "/recommendations"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Books
@using ReadNest.Application.Library
@using ReadNest.Application.Recommendations
@inject RecommendationService RecommendationService
@inject CatalogService Catalog
@inject LibraryService Library

<AppTitle Text="For you" />

<div class="rn-page" style="gap:44px">
    <div style="display:flex; flex-direction:column; gap:8px; max-width:720px">
        <h1 class="rn-mb-0" tabindex="-1">For you</h1>
        <p class="rn-lede" style="font-size:16px">Picked from your ratings, the authors you return to and the subjects on your shelves. No popularity scores and no sponsored books, only your own reading. Tell us when something isn’t for you and it won’t come back.</p>
    </div>

    @if (_error is not null)
    {
        <ErrorAlert Message="@_error" Title="We couldn’t gather suggestions" OnRetry="RefreshAsync" />
    }
    else if (_data is null)
    {
        <LoadingIndicator Kind="rows" Text="Finding books for you…" />
    }
    else
    {
        @foreach (var group in Groups)
        {
            <section class="rn-section" style="gap:18px" @key="group.Title">
                <h2 class="rn-mb-0">@group.Title</h2>
                <div class="rn-grid rn-grid-2">
                    @foreach (var item in group.Items)
                    {
                        <article class="rn-rec" @key="item.Book.Id">
                            <a class="rn-cover-button" href="@("books/" + item.Book.Id)" tabindex="-1" aria-hidden="true">
                                <BookCover Title="@item.Book.Title" Author="@First(item.Book.Authors)" Url="@item.Book.CoverUrl" Shadow="md" />
                            </a>
                            <div class="rn-rec-body">
                                <a class="rn-rec-title" href="@("books/" + item.Book.Id)">@item.Book.Title</a>
                                <span style="font-size:15px">@Authors(item.Book.Authors) <span class="rn-muted">@Meta(item.Book.PublishedYear, item.Book.PageCount)</span></span>
                                <p class="rn-why"><Icon Name="lightbulb" /><span>@item.Reason</span></p>
                                <div class="rn-actions" style="gap:6px 12px; margin-top:auto; padding-top:10px">
                                    @if (_added.Contains(item.Book.Id))
                                    {
                                        <StatusBadge Status="ReadingStatus.WantToRead" />
                                    }
                                    else
                                    {
                                        <button type="button" class="rn-btn rn-btn-secondary rn-btn-sm" disabled="@IsBusy" @onclick="() => WantAsync(item)"><Icon Name="plus" />Want to read</button>
                                    }
                                    <button type="button" class="rn-btn rn-btn-ghost muted rn-btn-sm" disabled="@IsBusy" @onclick="() => DismissAsync(item)"><Icon Name="x" />Not for me</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_further.Count > 0)
        {
            <section class="rn-section" style="gap:18px">
                <div class="rn-section-header">
                    <h2>A little further afield</h2>
                    <p>From the wider catalogue, by the authors and subjects you like most. Books already in your library are left out.</p>
                </div>
                <div class="rn-grid rn-grid-2">
                    @foreach (var pick in _further)
                    {
                        var book = pick.Book;
                        <article class="rn-rec" @key="book.Provider + book.ExternalId">
                            <a class="rn-cover-button" href="@CatalogHref(book)" tabindex="-1" aria-hidden="true">
                                <BookCover Title="@book.Title" Author="@First(book.Authors)" Url="@book.CoverUrl" Isbn="@book.Isbn13" Shadow="md" />
                            </a>
                            <div class="rn-rec-body">
                                <a class="rn-rec-title" href="@CatalogHref(book)">@book.Title</a>
                                <span style="font-size:15px">@Authors(book.Authors) <span class="rn-muted">@Meta(book.PublishedYear, book.PageCount)</span></span>
                                <p class="rn-why"><Icon Name="lightbulb" /><span>@pick.Why</span></p>
                                <div class="rn-actions" style="margin-top:auto; padding-top:10px">
                                    @if (_addedCatalog.Contains(book.ExternalId))
                                    {
                                        <StatusBadge Status="ReadingStatus.WantToRead" />
                                    }
                                    else
                                    {
                                        <button type="button" class="rn-btn rn-btn-secondary rn-btn-sm" disabled="@IsBusy" @onclick="() => WantCatalogAsync(book)"><Icon Name="plus" />Want to read</button>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
        else if (_furtherLoading)
        {
            <LoadingIndicator Kind="inline" Text="Looking further afield…" />
        }

        @if (_data.Items.Count == 0 && _further.Count == 0 && !_furtherLoading)
        {
            <div class="rn-empty plain">
                <h2>@(_data.SignalCount == 0 ? "Not enough to go on yet" : "That’s everything for now")</h2>
                <p>@(_data.SignalCount == 0
                    ? "Finish, rate or favourite a few books and suggestions will appear, each with the reason it’s here."
                    : "New suggestions appear as you rate and finish books.")</p>
                <div class="rn-actions">
                    @if (_data.DismissedCount > 0)
                    {
                        <button type="button" class="rn-btn rn-btn-secondary" disabled="@IsBusy" @onclick="RestoreAllAsync">Show dismissed suggestions</button>
                    }
                    <a class="rn-btn rn-btn-primary" href="explore"><Icon Name="compass" />Discover books</a>
                </div>
            </div>
        }
        else if (_data.DismissedCount > 0)
        {
            <p class="rn-subtle rn-mb-0">
                You’ve set aside @Formats.Count(_data.DismissedCount, "suggestion").
                <button type="button" class="rn-link-button" disabled="@IsBusy" @onclick="RestoreAllAsync">Show them again</button>
            </p>
        }
    }
</div>

@code {
    private sealed record Group(string Title, IReadOnlyList<RecommendationDto> Items);

    private sealed record FurtherPick(CatalogBook Book, string Why);

    private Guid _userId;
    private RecommendationsDto? _data;
    private string? _error;
    private readonly HashSet<Guid> _added = [];
    private readonly HashSet<string> _addedCatalog = [];
    private readonly List<FurtherPick> _further = [];
    private bool _furtherLoading;

    private IEnumerable<Group> Groups
    {
        get
        {
            if (_data is null)
            {
                yield break;
            }

            var authors = _data.Items.Where(i => i.Basis == ReasonKind.Author).ToList();
            var subjects = _data.Items.Where(i => i.Basis == ReasonKind.Genre).ToList();
            if (authors.Count > 0)
            {
                yield return new Group("Authors you already love", authors);
            }

            if (subjects.Count > 0)
            {
                yield return new Group("Subjects you keep returning to", subjects);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _userId = await RequireUserIdAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _error = await LoadAsync(async () => _data = await RecommendationService.GetRecommendationsAsync(_userId, 12, ComponentToken));
        if (_data is not null && _further.Count == 0)
        {
            await LoadFurtherAsync(_data.Topics);
        }
    }

    /// <summary>Two live catalogue searches at most per visit, to stay well inside the providers' rate limits.</summary>
    private async Task LoadFurtherAsync(DiscoveryTopicsDto topics)
    {
        var searches = new List<(CatalogSearchRequest Request, string Why)>();
        if (topics.Authors.FirstOrDefault() is { } author)
        {
            searches.Add((new CatalogSearchRequest(author, CatalogSearchField.Author, 1, 12), $"More by {author}, whose books you’ve enjoyed."));
        }

        if (topics.Genres.FirstOrDefault() is { } genre)
        {
            searches.Add((new CatalogSearchRequest(genre, CatalogSearchField.Subject, 1, 12), $"{genre}, a subject you keep returning to."));
        }

        if (searches.Count == 0)
        {
            return;
        }

        _furtherLoading = true;
        StateHasChanged();
        foreach (var (request, why) in searches)
        {
            try
            {
                var result = await Catalog.SearchAsync(request, ComponentToken);
                var keys = result.Items.Select(b => new CatalogMatchKey(b.Provider, b.ExternalId, b.Isbn13)).ToList();
                var owned = await Library.GetCatalogMatchesAsync(_userId, keys, ComponentToken);
                _further.AddRange(result.Items.Where(b => !owned.ContainsKey(b.ExternalId)).Take(3).Select(b => new FurtherPick(b, why)));
            }
            catch (Exception ex) when (Describe(ex) is not null)
            {
                // The wider catalogue is optional; suggestions from your own reading still show.
            }
        }

        _furtherLoading = false;
    }

    private async Task WantAsync(RecommendationDto item)
    {
        var userId = _userId;
        AddEntryResult? result = null;
        await RunAsync(
            async () =>
            {
                result = await Library.AddBookAsync(userId, new AddToLibraryRequest(item.Book.Id, ReadingStatus.WantToRead), ComponentToken);
                _added.Add(item.Book.Id);
            },
            "Added " + item.Book.Title + " to Want to read.",
            undo: async () =>
            {
                if (result is { AlreadyInLibrary: false })
                {
                    await Library.RemoveAsync(userId, result.EntryId, CancellationToken.None);
                    _added.Remove(item.Book.Id);
                }
            });
    }

    private async Task WantCatalogAsync(CatalogBook book)
    {
        var userId = _userId;
        AddEntryResult? result = null;
        await RunAsync(
            async () =>
            {
                result = await Library.AddCatalogBookAsync(userId, book, ReadingStatus.WantToRead, ComponentToken);
                _addedCatalog.Add(book.ExternalId);
            },
            "Added " + book.Title + " to Want to read.",
            undo: async () =>
            {
                if (result is { AlreadyInLibrary: false })
                {
                    await Library.RemoveAsync(userId, result.EntryId, CancellationToken.None);
                    _addedCatalog.Remove(book.ExternalId);
                }
            });
    }

    private async Task DismissAsync(RecommendationDto item)
    {
        var userId = _userId;
        var bookId = item.Book.Id;
        if (await RunAsync(
                () => RecommendationService.DismissAsync(userId, bookId, ComponentToken),
                "Got it. " + item.Book.Title + " won’t be suggested again.",
                undo: async () =>
                {
                    await RecommendationService.RestoreAsync(userId, bookId, CancellationToken.None);
                    await RefreshAsync();
                }))
        {
            _data = _data! with { Items = _data.Items.Where(i => i.Book.Id != bookId).ToList(), DismissedCount = _data.DismissedCount + 1 };
        }
    }

    private async Task RestoreAllAsync()
    {
        var restored = 0;
        if (await RunAsync(async () => restored = await RecommendationService.RestoreAllAsync(_userId, ComponentToken)))
        {
            Toasts.Success(Formats.Count(restored, "suggestion") + " restored.");
            await RefreshAsync();
        }
    }

    private static string? First(IReadOnlyList<string> authors) => authors.Count > 0 ? authors[0] : null;

    private static string Authors(IReadOnlyList<string> authors) => authors.Count > 0 ? string.Join(", ", authors) : "Unknown author";

    private static string Meta(int? year, int? pages)
    {
        var parts = new List<string>();
        if (year is { } y)
        {
            parts.Add(y.ToString(CultureInfo.InvariantCulture));
        }

        if (pages is { } p)
        {
            parts.Add(Formats.Count(p, "page"));
        }

        return parts.Count == 0 ? "" : "· " + string.Join(" · ", parts);
    }

    private static string CatalogHref(CatalogBook book) => $"explore/{book.Provider}/{Uri.EscapeDataString(book.ExternalId)}";
}
