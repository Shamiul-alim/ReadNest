@page "/explore/{Provider}/{ExternalId}"
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Books
@using ReadNest.Application.Library
@inject CatalogService Catalog
@inject BookService Books
@inject LibraryService Library

<AppTitle Text="@(_book?.Title ?? "Book")" />

@if (_loading)
{
    <LoadingIndicator Text="Loading book details…" />
}
else if (_error is not null)
{
    <div class="rn-page tight">
        <BackLink Href="explore" Text="Discover" />
        <ErrorAlert Message="@_error" Title="The catalogue didn’t respond" OnRetry="RefreshAsync" />
    </div>
}
else if (_book is not null)
{
    var genres = CategoryCleaner.Clean(_book.Categories);
    <div class="rn-page">
        <div style="display:flex; flex-direction:column; gap:22px">
            <BackLink Href="explore" Text="Discover" />
            <div class="rn-book-hero">
                <div class="rn-book-hero-aside">
                    <BookCover Title="@_book.Title" Author="@First" Url="@_book.CoverUrl" Isbn="@_book.Isbn13" Size="lg" Shadow="lg" Class="fill" Decorative="false" />
                </div>
                <div class="rn-book-hero-main">
                    @if (genres.Count > 0)
                    {
                        <div class="rn-chips" style="gap:6px">
                            @foreach (var genre in genres)
                            {
                                <a class="rn-tag" href="@("explore?field=Subject&q=" + Uri.EscapeDataString(genre))">@genre</a>
                            }
                        </div>
                    }
                    <h1 tabindex="-1">@_book.Title</h1>
                    @if (_book.Subtitle is not null)
                    {
                        <div class="rn-subtitle">@_book.Subtitle</div>
                    }
                    <div class="rn-byline">@(_book.Authors.Count > 1 ? "by " : "by ")<strong>@(_book.Authors.Count > 0 ? string.Join(", ", _book.Authors) : "Unknown author")</strong></div>
                    <div class="rn-subtle" style="font-size:15px">@Meta</div>
                    <div class="rn-status-panel">
                        @if (_userId is null)
                        {
                            <p class="rn-mb-0" style="font-size:16px">Sign in to keep this book in your library, track your place and save notes.</p>
                            <div class="rn-actions">
                                <a class="rn-btn rn-btn-primary" href="@("Account/Login?returnUrl=" + Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri)))">Sign in to add it</a>
                                <a class="rn-btn rn-btn-secondary" href="Account/Register">Create an account</a>
                            </div>
                        }
                        else
                        {
                            <p class="rn-mb-0" style="font-size:16px">Not in your library yet.</p>
                            <div class="rn-actions">
                                <button type="button" class="rn-btn rn-btn-primary" disabled="@IsBusy" @onclick="() => AddAsync(ReadingStatus.WantToRead)"><Icon Name="bookmark" />Want to read</button>
                                <button type="button" class="rn-btn rn-btn-secondary" disabled="@IsBusy" @onclick="() => AddAsync(ReadingStatus.CurrentlyReading)"><Icon Name="book-open" />Start reading</button>
                            </div>
                        }
                    </div>
                    <section aria-labelledby="about-h" class="rn-section rn-measure" style="gap:10px; margin-top:22px">
                        <h2 id="about-h" class="rn-mb-0">About this book</h2>
                        @if (!string.IsNullOrWhiteSpace(_book.Description))
                        {
                            <p class="rn-description">@_book.Description</p>
                        }
                        else
                        {
                            <p class="rn-subtle rn-mb-0">No description available for this edition.</p>
                        }
                    </section>
                    <dl class="rn-facts" style="margin-top:12px">
                        <div class="rn-fact"><dt>Publisher</dt><dd>@(_book.Publisher ?? "Not available")</dd></div>
                        <div class="rn-fact"><dt>Published</dt><dd>@(_book.PublishedDate ?? "Not available")</dd></div>
                        <div class="rn-fact"><dt>Pages</dt><dd>@(_book.PageCount?.ToString("N0") ?? "Not available")</dd></div>
                        <div class="rn-fact"><dt>Language</dt><dd>@(_book.Language?.ToUpperInvariant() ?? "Not available")</dd></div>
                        <div class="rn-fact"><dt>ISBN</dt><dd class="rn-mono">@(_book.Isbn13 ?? _book.Isbn10 ?? "Not available")</dd></div>
                        <div class="rn-fact">
                            <dt>Source</dt>
                            <dd>
                                @if (InputSanitizer.SafeExternalUrl(_book.InfoUrl) is { } infoUrl)
                                {
                                    <a href="@infoUrl" target="_blank" rel="noopener noreferrer nofollow">@_book.Provider.ToDisplayName() <Icon Name="external" Size="14" /></a>
                                }
                                else
                                {
                                    @_book.Provider.ToDisplayName()
                                }
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Provider { get; set; } = "";
    [Parameter] public string ExternalId { get; set; } = "";

    private Guid? _userId;
    private CatalogProvider _provider;
    private CatalogBook? _book;
    private bool _loading = true;
    private string? _error;

    private string? First => _book is { Authors.Count: > 0 } b ? b.Authors[0] : null;

    private string Meta
    {
        get
        {
            var parts = new List<string>();
            if (_book!.Publisher is { } publisher)
            {
                parts.Add(publisher);
            }

            if (_book.PublishedYear is { } year)
            {
                parts.Add(year.ToString(CultureInfo.InvariantCulture));
            }

            parts.Add(_book.PageCount is { } pages ? Formats.Count(pages, "page") : "Page count not available");
            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _userId = await GetUserIdAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        if (!Enum.TryParse(Provider, ignoreCase: true, out _provider) || !Enum.IsDefined(_provider))
        {
            _error = "That link points to a book source ReadNest doesn’t know.";
            _loading = false;
            return;
        }

        // A book that was already saved locally has a richer page (reviews, your reading status).
        if (await Books.FindByExternalIdAsync(_provider, ExternalId, ComponentToken) is { } localId)
        {
            Navigation.NavigateTo($"books/{localId}", replace: true);
            return;
        }

        _error = await LoadAsync(async () => _book = await Catalog.GetBookAsync(_provider, ExternalId, ComponentToken));
        _loading = false;
    }

    private async Task AddAsync(ReadingStatus status)
    {
        if (_userId is not { } userId || _book is null)
        {
            return;
        }

        AddEntryResult? result = null;
        var ok = await RunAsync(async () => result = await Library.AddCatalogBookAsync(userId, _book, status, ComponentToken));
        if (ok && result is not null)
        {
            Toasts.Success(result.AlreadyInLibrary
                ? "This book is already in your library."
                : status == ReadingStatus.WantToRead ? "Added to Want to read." : "Started. Happy reading.");
            Navigation.NavigateTo($"books/{result.BookId}");
        }
    }
}
