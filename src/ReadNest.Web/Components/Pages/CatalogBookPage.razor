@page "/explore/{Provider}/{ExternalId}"
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Books
@using ReadNest.Application.Library
@inject CatalogService Catalog
@inject BookService Books
@inject LibraryService Library

<AppTitle Text="@(_book?.Title ?? "Book")" />

@if (_loading)
{
    <LoadingIndicator Text="Loading book details…" />
}
else if (_error is not null)
{
    <PageHeader Title="Book unavailable" />
    <ErrorAlert Message="@_error" OnRetry="RefreshAsync" />
    <p class="mt-3"><a href="explore">Back to search</a></p>
}
else if (_book is not null)
{
    <nav class="rn-breadcrumb" aria-label="Breadcrumb"><a href="explore">Explore</a> <Icon Name="chevron-right" /> <span>@_book.Title</span></nav>
    <section class="rn-book-hero">
        <BookCover Title="@_book.Title" Author="@(_book.Authors.Count > 0 ? _book.Authors[0] : null)" Url="@_book.CoverUrl" Size="lg" Decorative="false" />
        <div>
            <h1 tabindex="-1">@_book.Title</h1>
            @if (_book.Subtitle is not null)
            {
                <div class="rn-subtitle">@_book.Subtitle</div>
            }
            <p class="rn-muted">
                @(_book.Authors.Count > 0 ? "by " + string.Join(", ", _book.Authors) : "Author unknown")
            </p>

            @if (_userId is not null)
            {
                <div class="rn-card tight rn-flex rn-flex-wrap">
                    <label class="rn-label" for="add-status">Add to my library as</label>
                    <select id="add-status" class="rn-select" style="width:auto" @bind="_status">
                        @foreach (var status in Enum.GetValues<ReadingStatus>())
                        {
                            <option value="@status">@status.ToDisplayName()</option>
                        }
                    </select>
                    <button type="button" class="rn-btn rn-btn-primary" disabled="@IsBusy" @onclick="AddAsync"><Icon Name="plus" /> Add to library</button>
                </div>
            }
            else
            {
                <a class="rn-btn rn-btn-primary" href="@("Account/Login?returnUrl=" + Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri)))">Log in to add this book</a>
            }

            <dl class="rn-facts">
                <div class="rn-fact"><dt>Published</dt><dd>@(_book.PublishedDate ?? "Unknown")</dd></div>
                <div class="rn-fact"><dt>Publisher</dt><dd>@(_book.Publisher ?? "Unknown")</dd></div>
                <div class="rn-fact"><dt>Pages</dt><dd>@(_book.PageCount?.ToString("N0") ?? "Unknown")</dd></div>
                <div class="rn-fact"><dt>Language</dt><dd>@(_book.Language?.ToUpperInvariant() ?? "Unknown")</dd></div>
                <div class="rn-fact"><dt>ISBN-13</dt><dd class="rn-mono">@(_book.Isbn13 ?? "—")</dd></div>
                <div class="rn-fact"><dt>ISBN-10</dt><dd class="rn-mono">@(_book.Isbn10 ?? "—")</dd></div>
            </dl>

            @if (CategoryCleaner.Clean(_book.Categories) is { Count: > 0 } genres)
            {
                <div class="rn-chips mb-3">
                    @foreach (var genre in genres)
                    {
                        <a class="rn-chip" href="@("explore?field=Subject&q=" + Uri.EscapeDataString(genre))">@genre</a>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_book.Description))
            {
                <div class="rn-description pre-wrap">@_book.Description</div>
            }
            else
            {
                <p class="rn-subtle">The catalogue has no description for this book.</p>
            }

            @if (InputSanitizer.SafeExternalUrl(_book.InfoUrl) is { } infoUrl)
            {
                <p class="mt-3 rn-subtle">
                    Source: <a href="@infoUrl" target="_blank" rel="noopener noreferrer nofollow">@_book.Provider.ToDisplayName() <Icon Name="external" /></a>
                </p>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string Provider { get; set; } = "";
    [Parameter] public string ExternalId { get; set; } = "";

    private Guid? _userId;
    private CatalogProvider _provider;
    private CatalogBook? _book;
    private bool _loading = true;
    private string? _error;
    private ReadingStatus _status = ReadingStatus.WantToRead;

    protected override async Task OnParametersSetAsync()
    {
        _userId = await GetUserIdAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        if (!Enum.TryParse(Provider, ignoreCase: true, out _provider) || !Enum.IsDefined(_provider))
        {
            _error = "Unknown book source.";
            _loading = false;
            return;
        }

        // A book that was already saved locally has a richer page (reviews, your reading status).
        if (await Books.FindByExternalIdAsync(_provider, ExternalId, ComponentToken) is { } localId)
        {
            Navigation.NavigateTo($"books/{localId}", replace: true);
            return;
        }

        _error = await LoadAsync(async () => _book = await Catalog.GetBookAsync(_provider, ExternalId, ComponentToken));
        _loading = false;
    }

    private async Task AddAsync()
    {
        if (_userId is not { } userId || _book is null)
        {
            return;
        }

        AddEntryResult? result = null;
        var ok = await RunAsync(async () => result = await Library.AddCatalogBookAsync(userId, _book, _status, ComponentToken));
        if (ok && result is not null)
        {
            Toasts.Success(result.AlreadyInLibrary ? "This book is already in your library." : "Added to your library.");
            Navigation.NavigateTo($"books/{result.BookId}");
        }
    }
}
