@page "/library"
@page "/library/want-to-read"
@page "/library/currently-reading"
@page "/library/read"
@page "/library/paused"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@inject LibraryService Library

<AppTitle Text="@View.Title" />

<PageHeader Title="@View.Title" Description="@View.Description">
    <Actions>
        <a class="rn-btn rn-btn-secondary" href="library/add"><Icon Name="plus" /> Add manually</a>
        <a class="rn-btn rn-btn-primary" href="explore"><Icon Name="search" /> Find books</a>
    </Actions>
</PageHeader>

<nav class="rn-tabs" aria-label="Reading status">
    @foreach (var view in Views)
    {
        <a class="rn-tab @(view.Path == View.Path ? "active" : null)" href="@view.Path" aria-current="@(view.Path == View.Path ? "page" : null)">
            @view.Short <span class="rn-count">@CountFor(view)</span>
        </a>
    }
</nav>

<form class="rn-toolbar" @onsubmit="ApplyFilters" role="search" aria-label="Filter library">
    <div class="rn-field rn-grow">
        <label class="rn-label" for="lib-search">Search your library</label>
        <input id="lib-search" class="rn-input" type="search" maxlength="200" placeholder="Title, author or ISBN" @bind="_search" />
    </div>
    <div class="rn-field">
        <label class="rn-label" for="lib-genre">Genre</label>
        <select id="lib-genre" class="rn-select" @bind="_genre">
            <option value="">All genres</option>
            @foreach (var genre in _options?.Genres ?? [])
            {
                <option value="@genre">@genre</option>
            }
        </select>
    </div>
    <div class="rn-field">
        <label class="rn-label" for="lib-author">Author</label>
        <select id="lib-author" class="rn-select" @bind="_author">
            <option value="">All authors</option>
            @foreach (var author in _options?.Authors ?? [])
            {
                <option value="@author">@author</option>
            }
        </select>
    </div>
    <div class="rn-field">
        <label class="rn-label" for="lib-rating">Rating</label>
        <select id="lib-rating" class="rn-select" @bind="_minRating">
            <option value="0">Any rating</option>
            <option value="5">★★★★★ only</option>
            <option value="4">4 stars &amp; up</option>
            <option value="3">3 stars &amp; up</option>
            <option value="1">Rated</option>
        </select>
    </div>
    <div class="rn-field">
        <label class="rn-label" for="lib-sort">Sort by</label>
        <select id="lib-sort" class="rn-select" @bind="_sort">
            <option value="@LibrarySort.LastUpdated">Last updated</option>
            <option value="@LibrarySort.DateAdded">Date added</option>
            <option value="@LibrarySort.Title">Title</option>
            <option value="@LibrarySort.Author">Author</option>
            <option value="@LibrarySort.CompletedOn">Date finished</option>
            <option value="@LibrarySort.Rating">Rating</option>
        </select>
    </div>
    <div class="rn-field">
        <label class="rn-label" for="lib-dir">Order</label>
        <select id="lib-dir" class="rn-select" @bind="Order">
            <option value="desc">@(SortIsText ? "Z → A" : "Newest / highest first")</option>
            <option value="asc">@(SortIsText ? "A → Z" : "Oldest / lowest first")</option>
        </select>
    </div>
    <label class="rn-check" style="align-self:center">
        <input type="checkbox" @bind="_favorites" /> <span>Favourites</span>
    </label>
    <button type="submit" class="rn-btn rn-btn-primary">Apply</button>
    @if (HasFilters)
    {
        <button type="button" class="rn-btn rn-btn-ghost" @onclick="ClearFilters">Clear</button>
    }
    <div class="rn-flex ms-auto" role="group" aria-label="Layout">
        <button type="button" class="rn-btn rn-btn-icon @(_listView ? "rn-btn-ghost" : "rn-btn-secondary")" aria-pressed="@(!_listView ? "true" : "false")" aria-label="Grid view" @onclick="() => _listView = false"><Icon Name="dashboard" /></button>
        <button type="button" class="rn-btn rn-btn-icon @(_listView ? "rn-btn-secondary" : "rn-btn-ghost")" aria-pressed="@(_listView ? "true" : "false")" aria-label="List view" @onclick="() => _listView = true"><Icon Name="list" /></button>
    </div>
</form>

@if (_loading && _result is null)
{
    <LoadingIndicator Text="Loading your books…" />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" OnRetry="RefreshAsync" />
}
else if (_result is not null)
{
    @if (_result.TotalCount == 0)
    {
        @if (HasFilters)
        {
            <EmptyState Title="No books match these filters" IconName="search" Text="Try removing a filter or searching for something else.">
                <button type="button" class="rn-btn rn-btn-secondary" @onclick="ClearFilters">Clear filters</button>
            </EmptyState>
        }
        else
        {
            <EmptyState Title="@View.EmptyTitle" IconName="library" Text="@View.EmptyText">
                <a class="rn-btn rn-btn-primary" href="explore">Discover books</a>
            </EmptyState>
        }
    }
    else if (_listView)
    {
        <div class="rn-card tight rn-table-wrap">
            <table class="rn-table">
                <thead>
                    <tr><th scope="col">Book</th><th scope="col">Status</th><th scope="col">Progress</th><th scope="col">Rating</th><th scope="col">Updated</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in _result.Items)
                    {
                        <tr @key="entry.Id">
                            <td>
                                <div class="rn-flex">
                                    <BookCover Title="@entry.Title" Url="@entry.CoverUrl" Size="xs" />
                                    <div style="min-width:0">
                                        <a class="rn-list-title" href="@("books/" + entry.BookId)">@entry.Title</a>
                                        <div class="rn-subtle rn-truncate">@string.Join(", ", entry.Authors)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <label class="visually-hidden" for="@("status-" + entry.Id)">Status for @entry.Title</label>
                                <select id="@("status-" + entry.Id)" class="rn-select" value="@entry.Status" @onchange="e => QuickStatusAsync(entry, e)">
                                    @foreach (var status in Enum.GetValues<ReadingStatus>())
                                    {
                                        <option value="@status">@status.ToDisplayName()</option>
                                    }
                                </select>
                            </td>
                            <td style="min-width:140px"><ProgressBar CurrentPage="entry.CurrentPage" TotalPages="entry.TotalPages" ShowLabel="false" /><span class="rn-subtle">@(entry.ProgressPercent is { } p ? p.ToString("0.#") + "%" : entry.CurrentPage > 0 ? "p. " + entry.CurrentPage : "—")</span></td>
                            <td><Stars Value="entry.Rating" ShowEmpty="true" /></td>
                            <td class="rn-subtle">@entry.UpdatedAtUtc.ToString("d MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="rn-book-grid">
            @foreach (var entry in _result.Items)
            {
                <LibraryBookCard Entry="entry" ShowStatus="@(View.Statuses is null || View.Statuses.Count > 1)" @key="entry.Id" />
            }
        </div>
    }

    <Pager Page="_result.Page" TotalPages="_result.TotalPages" TotalCount="_result.TotalCount" ItemName="books" OnPageChanged="GoToPage" />
}

@code {
    private sealed record LibraryView(string Path, string Title, string Short, string Description, IReadOnlyList<ReadingStatus>? Statuses, string EmptyTitle, string EmptyText);

    private static readonly LibraryView[] Views =
    [
        new("library", "My Library", "All", "Every book in your personal library.", null,
            "You haven't added any books yet", "Discover a book to start your library."),
        new("library/want-to-read", "Want to Read", "Want to Read", "Books you're planning to read.", [ReadingStatus.WantToRead],
            "Your reading list is empty", "Add books you'd like to read next."),
        new("library/currently-reading", "Currently Reading", "Reading", "Books you're reading right now.", [ReadingStatus.CurrentlyReading],
            "You're not reading anything right now", "Start a book from your Want to Read list."),
        new("library/read", "Read", "Read", "Books you've finished.", [ReadingStatus.Read],
            "No finished books yet", "Books you mark as read will appear here."),
        new("library/paused", "Paused & Did Not Finish", "Paused & DNF", "Books on hold or set aside.", [ReadingStatus.Paused, ReadingStatus.DidNotFinish],
            "Nothing paused or abandoned", "Books you pause or stop reading will appear here."),
    ];

    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "genre")] public string? Genre { get; set; }
    [SupplyParameterFromQuery(Name = "author")] public string? Author { get; set; }
    [SupplyParameterFromQuery(Name = "rating")] public int? Rating { get; set; }
    [SupplyParameterFromQuery(Name = "fav")] public bool? Favorites { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? Descending { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private Guid _userId;
    private PagedResult<LibraryEntryDto>? _result;
    private StatusCountsDto? _counts;
    private LibraryFilterOptionsDto? _options;
    private string? _error;
    private bool _loading;
    private bool _listView;

    private string _search = "";
    private string _genre = "";
    private string _author = "";
    private int _minRating;
    private bool _favorites;
    private LibrarySort _sort;
    private bool _descending = true;

    private LibraryView View
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            return Views.FirstOrDefault(v => string.Equals(v.Path, path, StringComparison.OrdinalIgnoreCase)) ?? Views[0];
        }
    }

    private bool HasFilters => !string.IsNullOrWhiteSpace(Q) || !string.IsNullOrEmpty(Genre) || !string.IsNullOrEmpty(Author) || Rating > 0 || Favorites == true;

    private bool SortIsText => _sort is LibrarySort.Title or LibrarySort.Author;

    private string Order
    {
        get => _descending ? "desc" : "asc";
        set => _descending = value != "asc";
    }

    protected override async Task OnInitializedAsync()
    {
        _userId = await RequireUserIdAsync();
        var error = await LoadAsync(async () =>
        {
            _options = await Library.GetFilterOptionsAsync(_userId, ComponentToken);
        });
        if (error is not null)
        {
            Toasts.Error(error);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _search = Q ?? "";
        _genre = Genre ?? "";
        _author = Author ?? "";
        _minRating = Math.Clamp(Rating ?? 0, 0, 5);
        _favorites = Favorites ?? false;
        _sort = Enum.TryParse<LibrarySort>(Sort, ignoreCase: true, out var sort) ? sort : LibrarySort.LastUpdated;
        _descending = Descending ?? !(_sort is LibrarySort.Title or LibrarySort.Author);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = await LoadAsync(async () =>
        {
            var statuses = View.Statuses;
            _result = await Library.ListAsync(_userId, new LibraryQuery
            {
                Search = Q,
                Statuses = statuses,
                Genre = Genre,
                Author = Author,
                MinRating = Rating > 0 ? Rating : null,
                FavoritesOnly = Favorites ?? false,
                Sort = _sort,
                Descending = _descending,
                Page = PageNumber ?? 1,
                PageSize = 24,
            }, ComponentToken);
            _counts = await Library.GetStatusCountsAsync(_userId, ComponentToken);
        });
        _loading = false;
    }

    private string? CountFor(LibraryView view) => _counts is null ? null
        : view.Statuses is null ? _counts.Total.ToString("N0")
        : view.Statuses.Sum(_counts.Get).ToString("N0");

    private void ApplyFilters() => Navigate(1);

    private void GoToPage(int page) => Navigate(page);

    private void ClearFilters()
    {
        _search = "";
        _genre = "";
        _author = "";
        _minRating = 0;
        _favorites = false;
        Navigate(1);
    }

    private void Navigate(int page)
    {
        var defaultDescending = !(_sort is LibrarySort.Title or LibrarySort.Author);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(View.Path, new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            ["genre"] = string.IsNullOrEmpty(_genre) ? null : _genre,
            ["author"] = string.IsNullOrEmpty(_author) ? null : _author,
            ["rating"] = _minRating > 0 ? _minRating : null,
            ["fav"] = _favorites ? true : null,
            ["sort"] = _sort == LibrarySort.LastUpdated ? null : _sort.ToString(),
            ["desc"] = _descending == defaultDescending ? null : _descending,
            ["page"] = page > 1 ? page : null,
        }));
    }

    private async Task QuickStatusAsync(LibraryEntryDto entry, ChangeEventArgs e)
    {
        if (!Enum.TryParse<ReadingStatus>(e.Value?.ToString(), out var status) || status == entry.Status)
        {
            return;
        }

        // Marking as read from the list uses today's date; it can be changed on the book page.
        var message = status == ReadingStatus.Read ? "Marked as read today. You can change the date on the book page." : $"Moved to {status.ToDisplayName()}.";
        await RunAsync(() => Library.UpdateStatusAsync(_userId, entry.Id, new UpdateStatusRequest(status), ComponentToken), message);
        await RefreshAsync();
    }
}
