@page "/collection"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@using ReadNest.Web.Components.Book
@inject CollectionService Collection
@inject LibraryService Library

<AppTitle Text="Collection & loans" />

<div class="rn-page" style="gap:44px">
    <PageHeader Title="Collection & loans" Description="@Summary">
        <Actions>
            <button type="button" class="rn-btn rn-btn-primary" @onclick="() => OpenLend(null, null)"><Icon Name="swap" />Lend a book</button>
        </Actions>
    </PageHeader>

    @if (_error is not null)
    {
        <ErrorAlert Message="@_error" Title="We couldn’t load your collection" OnRetry="RefreshAsync" />
    }
    else if (_summary is null || _loans is null || _owned is null || _borrowed is null)
    {
        <LoadingIndicator Kind="rows" Text="Loading your collection…" />
    }
    else
    {
        <div class="rn-columns" style="gap:36px 48px">
            <section aria-labelledby="lent-h" class="rn-section" style="gap:6px">
                <h2 id="lent-h" style="margin:0 0 6px">Out on loan</h2>
                @if (VisibleLoans.Count == 0)
                {
                    <p class="rn-subtle rn-mb-0">Nothing lent out. When a friend borrows a book, note it here so you remember who has it.</p>
                }
                @foreach (var loan in VisibleLoans)
                {
                    var state = LoanState(loan);
                    <div class="rn-list-item" style="flex-wrap:wrap; gap:10px 14px; padding:14px 0" @key="loan.Id">
                        <a class="rn-cover-button" style="width:44px; flex:none" href="@("books/" + loan.BookId)" tabindex="-1" aria-hidden="true"><BookCover Title="@loan.BookTitle" Url="@loan.CoverUrl" /></a>
                        <div class="rn-list-body" style="flex:1 1 180px">
                            <a class="rn-list-title" href="@("books/" + loan.BookId)">@loan.BookTitle</a>
                            <span style="font-size:14px">@loan.BorrowerName · <span class="rn-muted">since @Formats.Short(loan.LoanedOn, _today)</span></span>
                            <span class="rn-chip sm @state.Tone" style="align-self:flex-start; margin-top:4px"><Icon Name="@state.Icon" />@state.Text</span>
                        </div>
                        @if (loan.ReturnedOn is null)
                        {
                            <button type="button" class="rn-btn rn-btn-secondary rn-btn-sm" disabled="@IsBusy" @onclick="() => ReturnAsync(loan)"><Icon Name="check" />Mark returned</button>
                        }
                        else
                        {
                            <button type="button" class="rn-btn rn-btn-ghost rn-btn-icon" aria-label="@("Delete the loan record for " + loan.BookTitle)" disabled="@IsBusy" @onclick="() => DeleteLoanAsync(loan)"><Icon Name="trash" /></button>
                        }
                    </div>
                }
            </section>
            <section aria-labelledby="bor-h" class="rn-section" style="gap:6px">
                <h2 id="bor-h" style="margin:0 0 6px">Borrowed</h2>
                @if (_borrowed.Items.Count == 0)
                {
                    <p class="rn-subtle rn-mb-0">Books you’ve borrowed from friends or the library show up here. Set a book’s copy to “Borrowed” on its page.</p>
                }
                @foreach (var item in _borrowed.Items)
                {
                    <div class="rn-list-item" style="flex-wrap:wrap; gap:10px 14px; padding:14px 0" @key="item.EntryId">
                        <a class="rn-cover-button" style="width:44px; flex:none" href="@("books/" + item.BookId)" tabindex="-1" aria-hidden="true"><BookCover Title="@item.Title" Author="@First(item.Authors)" Url="@item.CoverUrl" /></a>
                        <div class="rn-list-body" style="flex:1 1 180px">
                            <a class="rn-list-title" href="@("books/" + item.BookId)">@item.Title</a>
                            <span class="rn-subtle">@(item.AcquiredOn is { } since ? "Borrowed since " + Formats.Short(since, _today) : "Borrowed")@(string.IsNullOrWhiteSpace(item.ConditionNotes) ? "" : " · " + item.ConditionNotes)</span>
                            <span style="align-self:flex-start; margin-top:4px"><StatusBadge Status="item.Status" /></span>
                        </div>
                        <button type="button" class="rn-btn rn-btn-secondary rn-btn-sm" disabled="@IsBusy" @onclick="() => GaveBackAsync(item)"><Icon Name="check" />Returned it</button>
                    </div>
                }
            </section>
        </div>

        <section aria-labelledby="own-h" class="rn-section">
            <div class="rn-section-header" style="align-items:center">
                <h2 id="own-h">Books you own</h2>
                <div class="rn-chips">
                    @foreach (var (format, label, count) in FormatChips)
                    {
                        var value = format;
                        <button type="button" class="rn-filter" aria-pressed="@(_format == value ? "true" : "false")" @onclick="() => SetFormatAsync(value)">@label <span class="count">@count</span></button>
                    }
                </div>
            </div>
            <form class="rn-input-icon" role="search" style="max-width:420px" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <Icon Name="search" />
                <input class="rn-input" type="search" maxlength="200" aria-label="Search books you own" placeholder="Search books you own" style="min-height:44px; font-size:15px" @bind="_search" />
            </form>
            @if (_owned.TotalCount == 0)
            {
                <p class="rn-subtle rn-mb-0">@(string.IsNullOrWhiteSpace(_search) && _format is null ? "No books are marked as owned yet. Open a book and set “Your copy” to Owned." : "No owned books match.")</p>
            }
            else
            {
                <div class="rn-list">
                    @foreach (var item in _owned.Items)
                    {
                        <div class="rn-list-item" style="flex-wrap:wrap; gap:8px 18px; padding:12px 0" @key="item.EntryId">
                            <div style="display:flex; align-items:center; gap:14px; flex:1 1 260px; min-width:0">
                                <a class="rn-cover-button" style="width:42px; flex:none" href="@("books/" + item.BookId)" tabindex="-1" aria-hidden="true"><BookCover Title="@item.Title" Author="@First(item.Authors)" Url="@item.CoverUrl" /></a>
                                <div class="rn-list-body">
                                    <a class="rn-list-title" href="@("books/" + item.BookId)">@item.Title</a>
                                    <span class="rn-subtle">@(item.Authors.Count > 0 ? string.Join(", ", item.Authors) : "Unknown author")</span>
                                </div>
                            </div>
                            <span style="flex:0 0 130px; display:flex; align-items:center; gap:8px; font-size:14px; font-weight:600"><Icon Name="@FormatIcon(item.Format)" />@(item.Format?.ToDisplayName() ?? "Physical")</span>
                            <span style="flex:1 1 200px; font-size:14px">@AcquiredText(item)</span>
                            <span style="flex:1 1 160px; display:flex; flex-wrap:wrap; align-items:center; gap:6px; font-size:14px; color:var(--color-neutral-700)">
                                @if (!string.IsNullOrWhiteSpace(item.ConditionNotes))
                                {
                                    <span>@item.ConditionNotes</span>
                                }
                                @if (item.OutstandingLoan is { } loan)
                                {
                                    <span class="rn-chip sm clay">With @loan.BorrowerName</span>
                                }
                                else
                                {
                                    <button type="button" class="rn-btn rn-btn-ghost rn-btn-sm" @onclick="() => OpenLend(item.EntryId, item.Title)"><Icon Name="swap" />Lend</button>
                                }
                            </span>
                        </div>
                    }
                </div>
                <Pager Page="_owned.Page" TotalPages="_owned.TotalPages" TotalCount="_owned.TotalCount" ItemName="books" OnPageChanged="LoadPageAsync" />
            }
            @if (_summary.TotalSpent > 0)
            {
                <span class="rn-subtle">@_summary.TotalSpent.ToString("N2", CultureInfo.CurrentCulture) spent, from the prices you’ve entered.</span>
            }
        </section>
    }
</div>

<LendDialog @bind-Open="_lendOpen" UserId="_userId" EntryId="_lendEntry" BookTitle="@_lendTitle" OnSaved="RefreshAsync" />
<ConfirmDialog @ref="_confirm" />

@code {
    private sealed record State(string Text, string Icon, string Tone);

    private Guid _userId;
    private DateOnly _today;
    private CollectionSummaryDto? _summary;
    private IReadOnlyList<LoanDto>? _loans;
    private PagedResult<CollectionItemDto>? _owned;
    private PagedResult<CollectionItemDto>? _borrowed;
    private string? _error;
    private string _search = "";
    private BookFormat? _format;
    private int _page = 1;
    private bool _lendOpen;
    private Guid? _lendEntry;
    private string? _lendTitle;
    private ConfirmDialog _confirm = default!;

    /// <summary>Everything still out, plus loans returned in the last 60 days.</summary>
    private List<LoanDto> VisibleLoans => _loans!.Where(l => l.ReturnedOn is null || l.ReturnedOn >= _today.AddDays(-60)).ToList();

    private string Summary => _summary is null
        ? "The copies you own, and who has borrowed them."
        : Formats.Count(_summary.OwnedBooks, "book") + " you own · " + Formats.Number(_summary.OnLoan) + " out on loan · " + Formats.Number(_summary.BorrowedFromOthers) + " borrowed";

    private IEnumerable<(BookFormat? Format, string Label, int Count)> FormatChips =>
    [
        (null, "All", _summary!.OwnedBooks),
        (BookFormat.Physical, "Physical", _summary.Physical),
        (BookFormat.EBook, "E-book", _summary.EBooks),
        (BookFormat.Audiobook, "Audiobook", _summary.Audiobooks),
    ];

    protected override async Task OnInitializedAsync()
    {
        _userId = await RequireUserIdAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _error = await LoadAsync(async () =>
        {
            _today = await Library.GetTodayAsync(_userId, ComponentToken);
            _summary = await Collection.GetSummaryAsync(_userId, ComponentToken);
            _loans = await Collection.GetLoansAsync(_userId, outstandingOnly: false, entryId: null, ComponentToken);
            _owned = await Collection.GetCollectionAsync(_userId, new CollectionQuery(_search, _format, LoanFilter.All, _page), ComponentToken);
            _borrowed = await Collection.GetCollectionAsync(_userId, new CollectionQuery(PageSize: 50, Ownership: OwnershipStatus.Borrowed), ComponentToken);
        });
    }

    private State LoanState(LoanDto loan)
    {
        if (loan.ReturnedOn is { } returned)
        {
            return new State("Returned " + Formats.Short(returned, _today), "check-circle", "sage");
        }

        if (loan.DueOn is not { } due)
        {
            return new State("No return date", "clock", "");
        }

        var days = due.DayNumber - _today.DayNumber;
        return days switch
        {
            < 0 => new State("Expected back " + Formats.Short(due, _today) + " · " + Formats.Count(-days, "day") + " ago", "clock", "soft-clay"),
            0 => new State("Expected back today", "clock", "soft-clay"),
            <= 7 => new State("Due soon · " + Formats.Short(due, _today), "clock", "soft-clay"),
            _ => new State("Due " + Formats.Short(due, _today), "calendar", ""),
        };
    }

    private static string FormatIcon(BookFormat? format) => format switch
    {
        BookFormat.EBook => "tablet",
        BookFormat.Audiobook => "headphones",
        _ => "book",
    };

    private string AcquiredText(CollectionItemDto item)
    {
        var parts = new List<string>();
        if (item.AcquiredOn is { } on)
        {
            parts.Add("Acquired " + Formats.Short(on, _today));
        }

        if (item.PurchasePrice is { } price)
        {
            parts.Add(price == 0 ? "Free" : price.ToString("N2", CultureInfo.CurrentCulture));
        }

        return parts.Count == 0 ? "No purchase details" : string.Join(" · ", parts);
    }

    private async Task SetFormatAsync(BookFormat? format)
    {
        _format = format;
        _page = 1;
        await RefreshAsync();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await RefreshAsync();
    }

    private async Task LoadPageAsync(int page)
    {
        _page = page;
        await RefreshAsync();
    }

    private void OpenLend(Guid? entryId, string? title)
    {
        _lendEntry = entryId;
        _lendTitle = title;
        _lendOpen = true;
    }

    private async Task ReturnAsync(LoanDto loan)
    {
        if (await RunAsync(() => Collection.ReturnAsync(_userId, loan.Id, null, ComponentToken), loan.BookTitle + " is back on your shelf."))
        {
            await RefreshAsync();
        }
    }

    private async Task GaveBackAsync(CollectionItemDto item)
    {
        var userId = _userId;
        var entryId = item.EntryId;
        var undo = new OwnershipRequest(OwnershipStatus.Borrowed, item.Format, item.AcquiredOn, item.PurchasePrice, item.ConditionNotes);
        if (await RunAsync(
                () => Collection.UpdateOwnershipAsync(userId, entryId, new OwnershipRequest(OwnershipStatus.NotOwned, item.Format, null, null, null), ComponentToken),
                "Marked " + item.Title + " as returned to its owner.",
                undo: async () =>
                {
                    await Collection.UpdateOwnershipAsync(userId, entryId, undo, CancellationToken.None);
                    await RefreshAsync();
                }))
        {
            await RefreshAsync();
        }
    }

    private async Task DeleteLoanAsync(LoanDto loan)
    {
        if (await _confirm.ConfirmAsync("Delete this loan record?", "Use this only to correct a mistake. Returned loans are kept as lending history.", "Delete record")
            && await RunAsync(() => Collection.DeleteLoanAsync(_userId, loan.Id, ComponentToken), "Loan record deleted."))
        {
            await RefreshAsync();
        }
    }

    private static string? First(IReadOnlyList<string> authors) => authors.Count > 0 ? authors[0] : null;
}
