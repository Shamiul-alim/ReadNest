@page "/shelves"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@using ReadNest.Web.Components.Book
@inject ShelfService ShelfService

<AppTitle Text="Shelves" />

<div class="rn-page tight">
    <PageHeader Title="Shelves" Description="Group books however makes sense to you. A book can live on as many shelves as you like.">
        <Actions>
            <button type="button" class="rn-btn rn-btn-primary" @onclick="() => _newOpen = true"><Icon Name="plus" />New shelf</button>
        </Actions>
    </PageHeader>

    @if (_error is not null)
    {
        <ErrorAlert Message="@_error" Title="We couldn’t load your shelves" OnRetry="RefreshAsync" />
    }
    else if (_shelves is null)
    {
        <LoadingIndicator Kind="grid" Text="Loading your shelves…" />
    }
    else
    {
        <div class="rn-grid" style="grid-template-columns:repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap:22px">
            @foreach (var shelf in _shelves)
            {
                <a class="rn-shelf-card" href="@("shelves/" + shelf.Id)" @key="shelf.Id">
                    <CoverFan Books="shelf.Previews ?? []" />
                    <span style="display:flex; flex-direction:column; gap:4px">
                        <span class="rn-shelf-name">@shelf.Name</span>
                        @if (!string.IsNullOrWhiteSpace(shelf.Description))
                        {
                            <span class="rn-subtle" style="line-height:1.5">@shelf.Description</span>
                        }
                    </span>
                    <span class="rn-shelf-meta">
                        <span>@Formats.Count(shelf.BookCount, "book")</span>
                        <span><Icon Name="@(shelf.IsPublic ? "globe" : "lock")" Size="15" />@(shelf.IsPublic ? "Public" : "Private")</span>
                    </span>
                </a>
            }
            <button type="button" class="rn-shelf-card new" @onclick="() => _newOpen = true">
                <span class="rn-icon-circle neutral" style="width:52px; height:52px"><Icon Name="plus" /></span>
                <span class="rn-heading">New shelf</span>
            </button>
        </div>
    }
</div>

<ShelfEditDialog @bind-Open="_newOpen" UserId="_userId" OnSaved="OnCreated" />

@code {
    private Guid _userId;
    private IReadOnlyList<ShelfDto>? _shelves;
    private string? _error;
    private bool _newOpen;

    protected override async Task OnInitializedAsync()
    {
        _userId = await RequireUserIdAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync() =>
        _error = await LoadAsync(async () => _shelves = await ShelfService.ListAsync(_userId, ComponentToken));

    private void OnCreated(Guid shelfId) => Navigation.NavigateTo("shelves/" + shelfId);
}
