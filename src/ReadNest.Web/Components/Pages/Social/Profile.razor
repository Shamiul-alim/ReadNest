@page "/profile"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Social
@inject ProfileService Profiles

@* Your own public profile, as other readers see it. Editing lives in Settings. *@
@if (_error is not null)
{
    <ErrorAlert Message="@_error" Title="We couldn’t load your profile" OnRetry="LoadHandleAsync" />
}
else if (_handle is null)
{
    <LoadingIndicator Text="Loading your profile…" />
}
else
{
    <ProfileView Handle="@_handle" />
}

@code {
    private string? _handle;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadHandleAsync();

    private async Task LoadHandleAsync()
    {
        _error = await LoadAsync(async () =>
        {
            var userId = await RequireUserIdAsync();
            _handle = (await Profiles.GetOrCreateAsync(userId, null, null, ComponentToken)).Handle;
        });
    }
}
