@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@using ReadNest.Application.Reviews
@using ReadNest.Application.Social
@inject SocialService Social
@inject ReviewService Reviews
@inject ProfileService Profiles

@* A reader's public profile. On their own profile the reader sees a banner explaining what others can see. *@
<AppTitle Text="@(_profile?.DisplayName ?? "Reader")" />

@if (_error is not null)
{
    <div class="rn-empty" style="max-width:620px">
        <span class="rn-icon-circle lg neutral"><Icon Name="lock" /></span>
        <h1 tabindex="-1">This profile isn’t available</h1>
        <p>The reader may have made it private, or the link may be wrong.</p>
        <div class="rn-actions"><a class="rn-btn rn-btn-secondary" href="community">Find readers</a></div>
    </div>
}
else if (_profile is null)
{
    <LoadingIndicator Text="Loading profile…" />
}
else
{
    var profile = _profile;
    <div class="rn-page" style="gap:44px">
        @if (profile.IsOwnProfile)
        {
            @if (_ownIsPublic)
            {
                <div class="rn-banner sage"><span><Icon Name="globe" />This is how other readers see your profile.</span><a class="rn-btn rn-btn-secondary rn-btn-sm" style="color:inherit" href="settings">Edit profile and privacy</a></div>
            }
            else
            {
                <div class="rn-banner neutral"><span><Icon Name="lock" />Your profile is private. Only you can see this page.</span><a class="rn-btn rn-btn-secondary rn-btn-sm" href="settings?tab=privacy">Privacy settings</a></div>
            }
        }
        <section class="rn-profile-hero">
            <Avatar Name="@profile.DisplayName" ImageUrl="@profile.ProfileImageUrl" Size="xl" />
            <div>
                <h1 tabindex="-1">@profile.DisplayName</h1>
                <span style="font-size:16px; color:var(--color-neutral-700)">@@@profile.Handle</span>
                @if (!string.IsNullOrWhiteSpace(profile.Bio))
                {
                    <p class="rn-mb-0 pre-wrap" style="margin-top:4px; font-size:17px; line-height:1.6; max-width:56ch">@profile.Bio</p>
                }
                <div class="rn-stats" style="gap:14px 36px; padding-top:10px">
                    @if (profile.BooksRead is { } read)
                    {
                        <StatCard Value="@Formats.Number(read)" Label="@(read == 1 ? "book read" : "books read")" />
                    }
                    <StatCard Value="@Formats.Number(profile.Following)" Label="following" />
                    <StatCard Value="@Formats.Number(profile.Followers)" Label="@(profile.Followers == 1 ? "follower" : "followers")" />
                </div>
                <div class="rn-actions" style="padding-top:6px">
                    @if (profile.IsOwnProfile)
                    {
                        <a class="rn-btn rn-btn-secondary rn-btn-sm" href="settings"><Icon Name="pencil" />Edit profile</a>
                    }
                    else if (_userId is null)
                    {
                        <a class="rn-btn rn-btn-primary rn-btn-sm" href="@("Account/Login?returnUrl=" + Uri.EscapeDataString("u/" + Handle))">Sign in to follow</a>
                    }
                    else if (profile.IsFollowing)
                    {
                        <button type="button" class="rn-btn rn-btn-secondary rn-btn-sm" aria-pressed="true" disabled="@IsBusy" @onclick="UnfollowAsync"><Icon Name="check" />Following</button>
                    }
                    else
                    {
                        <button type="button" class="rn-btn rn-btn-primary rn-btn-sm" aria-pressed="false" disabled="@IsBusy" @onclick="FollowAsync"><Icon Name="plus" />Follow</button>
                    }
                </div>
            </div>
        </section>

        @if (profile.CurrentlyReading.Count > 0)
        {
            <section aria-labelledby="pr-h" class="rn-section">
                <h2 id="pr-h" class="rn-mb-0">Reading now</h2>
                <div style="display:flex; flex-wrap:wrap; gap:20px">
                    @foreach (var book in profile.CurrentlyReading)
                    {
                        <a class="rn-row-link" style="width:260px; margin:0" href="@(book.IsCatalogBook ? "books/" + book.BookId : "u/" + Handle)">
                            <span style="width:56px; flex:none"><BookCover Title="@book.Title" Author="@(book.Authors.Count > 0 ? book.Authors[0] : null)" Url="@book.CoverUrl" /></span>
                            <span class="rn-list-body"><span class="rn-list-title">@book.Title</span><span class="rn-subtle">@string.Join(", ", book.Authors)</span></span>
                        </a>
                    }
                </div>
            </section>
        }

        <section aria-labelledby="ps-h" class="rn-section">
            <h2 id="ps-h" class="rn-mb-0">Public shelves</h2>
            @if (profile.PublicShelves.Count == 0)
            {
                <p class="rn-subtle rn-mb-0">@(profile.IsOwnProfile ? "None yet. Make a shelf public from its Edit dialog or in Settings." : "No public shelves yet.")</p>
            }
            else
            {
                <div class="rn-grid" style="grid-template-columns:repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap:20px">
                    @foreach (var shelf in profile.PublicShelves)
                    {
                        <a class="rn-shelf-card" style="padding:20px; gap:14px" href="@("s/" + shelf.ShareSlug)">
                            <CoverFan Books="shelf.Previews ?? []" Small="true" />
                            <span class="rn-shelf-name" style="font-size:19px">@shelf.Name</span>
                            <span class="rn-subtle">@Formats.Count(shelf.BookCount, "book")</span>
                        </a>
                    }
                </div>
            }
        </section>

        @if (profile.IsLibraryPublic || profile.IsOwnProfile)
        {
            <section aria-labelledby="rl-h" class="rn-section">
                <div class="rn-section-header"><h2 id="rl-h">Reading list</h2></div>
                <div class="rn-chips">
                    <button type="button" class="rn-filter" aria-pressed="@(_status is null ? "true" : "false")" @onclick="() => FilterAsync(null)">All</button>
                    @foreach (var status in Enum.GetValues<ReadingStatus>())
                    {
                        var s = status;
                        <button type="button" class="rn-filter" aria-pressed="@(_status == s ? "true" : "false")" @onclick="() => FilterAsync(s)">@s.ToDisplayName()</button>
                    }
                </div>
                @if (_library is null)
                {
                    <LoadingIndicator Kind="grid" />
                }
                else if (_library.TotalCount == 0)
                {
                    <p class="rn-subtle rn-mb-0">No books here.</p>
                }
                else
                {
                    <div class="rn-book-grid compact" role="list">
                        @foreach (var book in _library.Items)
                        {
                            <PublicBookCard Book="book" ShowStatus="true" />
                        }
                    </div>
                    <Pager Page="_library.Page" TotalPages="_library.TotalPages" TotalCount="_library.TotalCount" ItemName="books" OnPageChanged="LibraryPageAsync" />
                }
                @if (profile.IsOwnProfile && !profile.IsLibraryPublic)
                {
                    <p class="rn-subtle rn-mb-0"><Icon Name="lock" Size="15" /> Only you can see this list. Make it public in <a href="settings?tab=privacy">Settings</a>.</p>
                }
            </section>
        }

        @if (_reviews is { TotalCount: > 0 })
        {
            <section aria-labelledby="prv-h" class="rn-section" style="max-width:820px; gap:0">
                <h2 id="prv-h" style="margin:0 0 6px">Reviews</h2>
                @foreach (var review in _reviews.Items)
                {
                    <article class="rn-review">
                        <a class="rn-cover-button" href="@("books/" + review.BookId)" tabindex="-1" aria-hidden="true"><BookCover Title="@review.BookTitle" Url="@review.CoverUrl" /></a>
                        <div>
                            <a class="rn-review-title" href="@("books/" + review.BookId)">@review.BookTitle</a>
                            <span class="rn-review-meta"><Stars Value="review.Rating" IconSize="15" />@Formats.Long(review.UpdatedAtUtc)</span>
                            <p>@review.Review</p>
                        </div>
                    </article>
                }
            </section>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Handle { get; set; } = "";

    private Guid? _userId;
    private PublicProfileDto? _profile;
    private bool _ownIsPublic;
    private PagedResult<PublicBookDto>? _library;
    private PagedResult<PublicReviewDto>? _reviews;
    private ReadingStatus? _status;
    private int _libraryPage = 1;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _userId = await GetUserIdAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _error = await LoadAsync(async () =>
        {
            _profile = await Social.GetPublicProfileAsync(Handle, _userId, ComponentToken);
            if (_profile.IsOwnProfile && _userId is { } me)
            {
                _ownIsPublic = (await Profiles.GetAsync(me, ComponentToken))?.IsProfilePublic ?? false;
            }

            _reviews = await Reviews.GetRecentPublicReviewsAsync(1, 10, _profile.UserId, ComponentToken);
            if (_profile.IsLibraryPublic || _profile.IsOwnProfile)
            {
                _library = await Social.GetPublicLibraryAsync(Handle, _userId, _status, _libraryPage, ComponentToken);
            }
        });
    }

    private async Task FilterAsync(ReadingStatus? status)
    {
        _status = status;
        _libraryPage = 1;
        await LoadLibraryAsync();
    }

    private async Task LibraryPageAsync(int page)
    {
        _libraryPage = page;
        await LoadLibraryAsync();
    }

    private async Task LoadLibraryAsync()
    {
        var error = await LoadAsync(async () => _library = await Social.GetPublicLibraryAsync(Handle, _userId, _status, _libraryPage, ComponentToken));
        if (error is not null)
        {
            Toasts.Error(error);
        }
    }

    private async Task FollowAsync()
    {
        if (_userId is { } userId && await RunAsync(() => Social.FollowAsync(userId, Handle, ComponentToken), "You’re following " + _profile?.DisplayName + "."))
        {
            await RefreshAsync();
        }
    }

    private async Task UnfollowAsync()
    {
        if (_userId is { } userId && await RunAsync(() => Social.UnfollowAsync(userId, Handle, ComponentToken), "Unfollowed " + _profile?.DisplayName + "."))
        {
            await RefreshAsync();
        }
    }
}
