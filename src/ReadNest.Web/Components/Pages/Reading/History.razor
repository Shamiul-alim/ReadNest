@page "/history"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Reading
@inject ReadingSessionService Sessions

<AppTitle Text="Reading history" />


<div class="rn-page tight">
<PageHeader Title="Reading history" Description="Every reading session you’ve logged, newest first. Updating your page records a session automatically." />

<form class="rn-toolbar" @onsubmit="Apply" @onsubmit:preventDefault aria-label="Filter sessions by date">
    <label class="rn-sort">From <input class="rn-input" style="width:auto; min-height:44px; font-size:15px" type="date" @bind="_from" /></label>
    <label class="rn-sort">To <input class="rn-input" style="width:auto; min-height:44px; font-size:15px" type="date" @bind="_to" /></label>
    <button type="submit" class="rn-btn rn-btn-secondary rn-btn-sm">Show</button>
    @if (From is not null || To is not null || Entry is not null)
    {
        <a class="rn-btn rn-btn-ghost" href="history">Show all</a>
    }
</form>

@if (_error is not null)
{
    <ErrorAlert Message="@_error" Title="We couldn’t load your sessions" OnRetry="RefreshAsync" />
}
else if (_page is null)
{
    <LoadingIndicator Kind="rows" />
}
else if (_page.TotalCount == 0)
{
    <EmptyState Title="No reading sessions yet" IconName="clock" Variant="dashed"
                Text="Update your page from the reading view and a session is recorded for you. Log one by hand to add time and a reflection.">
        <a class="rn-btn rn-btn-primary" href="library/currently-reading">Books you’re reading</a>
    </EmptyState>
}
else
{
    <p class="rn-mb-0" style="font-size:15px; color:var(--color-neutral-700)">
        @Formats.Count(_page.TotalCount, "session") · @Formats.Count(_page.Items.Sum(s => s.PagesRead), "page") and @Formats.Duration(_page.Items.Sum(s => s.DurationMinutes)) on this page
    </p>
    <div style="max-width:820px; display:flex; flex-direction:column; gap:22px">
        @foreach (var day in _page.Items.GroupBy(s => s.ReadOn))
        {
            <section class="rn-day" @key="day.Key">
                <h2 class="rn-day-heading" style="margin:0">@day.Key.ToString("dddd, MMMM d, yyyy", CultureInfo.CurrentCulture) · @Formats.Count(day.Sum(s => s.PagesRead), "page")</h2>
                <ol class="rn-timeline">
                    @foreach (var session in day)
                    {
                        <li @key="session.Id">
                            <a class="rn-cover-button" style="width:40px; flex:none" href="@("books/" + session.BookId)" tabindex="-1" aria-hidden="true"><BookCover Title="@session.BookTitle" Url="@session.CoverUrl" /></a>
                            <div>
                                <div class="head"><a class="rn-list-title" style="font-size:16px" href="@("books/" + session.BookId)">@session.BookTitle</a><span>@Formats.Count(session.PagesRead, "page")</span></div>
                                <div class="meta">p. @session.StartPage.ToString("N0")–@session.EndPage.ToString("N0")@(session.DurationMinutes > 0 ? " · " + Formats.Duration(session.DurationMinutes) : "")</div>
                                @if (!string.IsNullOrWhiteSpace(session.Reflection))
                                {
                                    <p class="pre-wrap">@session.Reflection</p>
                                }
                            </div>
                        </li>
                    }
                </ol>
            </section>
        }
    </div>
    <Pager Page="_page.Page" TotalPages="_page.TotalPages" TotalCount="_page.TotalCount" ItemName="sessions" OnPageChanged="GoToPage" />
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "entry")] public Guid? Entry { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private Guid _userId;
    private PagedResult<ReadingSessionDto>? _page;
    private string? _error;
    private DateOnly? _from;
    private DateOnly? _to;

    protected override async Task OnParametersSetAsync()
    {
        _userId = await RequireUserIdAsync();
        _from = DateOnly.TryParse(From, CultureInfo.InvariantCulture, out var from) ? from : null;
        _to = DateOnly.TryParse(To, CultureInfo.InvariantCulture, out var to) ? to : null;
        await RefreshAsync();
    }

    private async Task RefreshAsync() =>
        _error = await LoadAsync(async () =>
            _page = await Sessions.GetHistoryAsync(_userId, new HistoryQuery(_from, _to, Entry, PageNumber ?? 1, 50), ComponentToken));

    private void Apply() => Navigate(1);

    private void GoToPage(int page) => Navigate(page);

    private void Navigate(int page) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("history", new Dictionary<string, object?>
        {
            ["from"] = _from?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["to"] = _to?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["entry"] = Entry,
            ["page"] = page > 1 ? page : null,
        }));
}
