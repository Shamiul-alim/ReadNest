@page "/notes"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@using ReadNest.Application.Notes
@using ReadNest.Web.Components.Book
@inject NoteService NoteService
@inject LibraryService Library

<AppTitle Text="Notes & journal" />

@if (_error is not null)
{
    <ErrorAlert Message="@_error" Title="We couldn’t load your journal" OnRetry="RefreshAsync" />
}
else if (_notes is null)
{
    <LoadingIndicator Kind="rows" Text="Opening your journal…" />
}
else if (_notes.TotalCount == 0 && !Filtered)
{
    <div class="rn-empty" style="max-width:620px">
        <span class="rn-icon-circle lg"><Icon Name="notebook" /></span>
        <h1 tabindex="-1">Your journal is empty, for now</h1>
        <p style="color:var(--color-text)">Save a line you underlined, a lesson you want to remember or something you mean to try. Each note links back to its book and page.</p>
        @if (_books.Count > 0)
        {
            <button type="button" class="rn-btn rn-btn-primary" @onclick="() => OpenNew(NoteType.General)"><Icon Name="pen-line" />Write your first note</button>
        }
        else
        {
            <a class="rn-btn rn-btn-primary" href="explore"><Icon Name="compass" />Add a book first</a>
        }
    </div>
}
else
{
    <div class="rn-page snug">
        <PageHeader Title="Notes & journal" Description="@(Formats.Count(_total, "note") + " from " + Formats.Count(_withNotes.Count, "book") + ". Everything you keep, in one quiet place.")">
            <Actions>
                <button type="button" class="rn-btn rn-btn-primary" @onclick="() => OpenNew(NoteType.General)"><Icon Name="plus" />New note</button>
            </Actions>
        </PageHeader>
        <div class="rn-toolbar">
            <form class="rn-input-icon" role="search" style="flex:1 1 240px; max-width:420px" @onsubmit="Apply" @onsubmit:preventDefault>
                <Icon Name="search" />
                <input class="rn-input" type="search" maxlength="200" aria-label="Search your notes" placeholder="Search your notes" style="min-height:44px; font-size:15px" @bind="_search" />
            </form>
            <div class="rn-sort" style="min-width:0">
                <span id="notes-book-label">Book</span>
                <AppSelect TValue="Guid?" Id="notes-book" Class="auto rn-notes-book" Size="sm" AriaLabelledBy="notes-book-label" Value="Entry" ValueChanged="OnBookChanged"
                           Searchable="@(_withNotes.Count > 8)" SearchPlaceholder="Find a book"
                           Options="@([SelectOption.Of<Guid?>(null, "All books"), .. _withNotes.Select(b => SelectOption.Of<Guid?>(b.EntryId, b.Title, hint: Formats.Count(b.Count, "note")))])" />
            </div>
        </div>
        <div aria-label="Filter by note type" class="rn-chips">
            <a class="rn-filter" aria-pressed="@(TypeFilter is null ? "true" : "false")" href="@Link(type: "", keepType: false)">All</a>
            @foreach (var type in Enum.GetValues<NoteType>())
            {
                <a class="rn-filter" aria-pressed="@(TypeFilter == type ? "true" : "false")" href="@Link(type: type.ToString(), keepType: false)">@type.ToDisplayName()</a>
            }
        </div>

        @if (_notes.TotalCount == 0)
        {
            <div class="rn-empty plain">
                <h2>No notes match</h2>
                <p>Try another word, or clear the filters to see everything.</p>
                <div class="rn-actions"><a class="rn-btn rn-btn-secondary" href="notes">Clear filters</a></div>
            </div>
        }
        else
        {
            <div style="display:flex; flex-wrap:wrap; gap:28px; align-items:flex-start">
                <div role="list" class="rn-note-list @(_paneOnMobile ? "rn-hide-mobile" : null)">
                    @foreach (var note in _notes.Items)
                    {
                        <button type="button" role="listitem" class="rn-note-item" aria-current="@(_selected?.Id == note.Id ? "true" : "false")" @onclick="() => Pick(note)" @key="note.Id">
                            <span style="display:flex; justify-content:space-between; gap:10px; align-items:center">
                                <NoteTypeBadge Type="note.Type" />
                                <span class="rn-small rn-muted">@Formats.Short(DateOnly.FromDateTime(note.CreatedAtUtc), _today)</span>
                            </span>
                            <span class="text">@(note.Type == NoteType.Quote ? "“" + note.Content + "”" : note.Content)</span>
                            <span class="ref">@note.BookTitle@(NoteCard.Reference(note) is { } r ? " · " + r : "")</span>
                        </button>
                    }
                    @if (_notes.HasNext || _notes.HasPrevious)
                    {
                        <Pager Page="_notes.Page" TotalPages="_notes.TotalPages" TotalCount="_notes.TotalCount" ItemName="notes" OnPageChanged="GoToPage" />
                    }
                </div>
                @if (_selected is { } sel)
                {
                    <article aria-label="Selected note" class="rn-note-pane @(_paneOnMobile ? null : "rn-hide-mobile")">
                        <button type="button" class="rn-btn rn-btn-ghost rn-only-mobile" style="align-self:flex-start" @onclick="() => _paneOnMobile = false"><Icon Name="arrow-left" />All notes</button>
                        <div style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; align-items:center">
                            <NoteTypeBadge Type="sel.Type" Large="true" />
                            @if (NoteCard.Reference(sel) is { } reference)
                            {
                                <span class="rn-subtle">@reference</span>
                            }
                        </div>
                        @if (sel.Type == NoteType.Quote)
                        {
                            <blockquote>“@sel.Content”</blockquote>
                        }
                        else
                        {
                            <p class="body">@sel.Content</p>
                        }
                        <a class="rn-row-link" style="align-self:flex-start; margin:0 -12px; padding:12px" href="@("books/" + sel.BookId)">
                            <BookCover Title="@sel.BookTitle" Author="@(sel.Authors is { Count: > 0 } a ? a[0] : null)" Url="@sel.CoverUrl" Size="xs" />
                            <span class="rn-list-body">
                                <span class="rn-list-title">@sel.BookTitle</span>
                                <span class="rn-subtle">@(sel.Authors is { Count: > 0 } names ? string.Join(", ", names) : "")</span>
                            </span>
                            <Icon Name="chevron-right" />
                        </a>
                        <div class="rn-note-pane-foot">
                            <span>Saved @Formats.Long(sel.CreatedAtUtc)@(sel.UpdatedAtUtc > sel.CreatedAtUtc.AddMinutes(1) ? " · edited " + Formats.Long(sel.UpdatedAtUtc) : "")</span>
                            <div class="rn-actions" style="gap:8px">
                                <button type="button" class="rn-btn rn-btn-secondary rn-btn-sm" @onclick="() => OpenEdit(sel)"><Icon Name="pencil" />Edit</button>
                                <button type="button" class="rn-btn rn-btn-ghost rn-btn-sm" disabled="@IsBusy" @onclick="() => DeleteAsync(sel)"><Icon Name="trash" />Delete</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
}

<NoteDialog @bind-Open="_dialogOpen" UserId="_userId" EntryId="@(_editing is null ? Entry : null)" Books="_books" Note="_editing" InitialType="_newType" OnSaved="AfterSaveAsync" />
<ConfirmDialog @ref="_confirm" />

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [SupplyParameterFromQuery(Name = "entry")] public Guid? Entry { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private Guid _userId;
    private DateOnly _today;
    private PagedResult<NoteDto>? _notes;
    private IReadOnlyList<NamedEntryDto> _withNotes = [];
    private IReadOnlyList<NoteDialog.BookOption> _books = [];
    private NoteDto? _selected;
    private NoteDto? _editing;
    private NoteType _newType;
    private bool _dialogOpen;
    private bool _paneOnMobile;
    private int _total;
    private string _search = "";
    private string? _error;
    private ConfirmDialog _confirm = default!;

    private NoteType? TypeFilter => Enum.TryParse<NoteType>(Type, ignoreCase: true, out var type) && Enum.IsDefined(type) ? type : null;

    private bool Filtered => !string.IsNullOrWhiteSpace(Q) || TypeFilter is not null || Entry is not null;

    protected override async Task OnInitializedAsync()
    {
        _userId = await RequireUserIdAsync();
        var error = await LoadAsync(async () =>
        {
            _today = await Library.GetTodayAsync(_userId, ComponentToken);
            await LoadBooksAsync();
        });
        if (error is not null)
        {
            Toasts.Error(error);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _search = Q ?? "";
        await RefreshAsync();
    }

    private async Task LoadBooksAsync()
    {
        _withNotes = await NoteService.GetBooksWithNotesAsync(_userId, ComponentToken);
        _total = _withNotes.Sum(b => b.Count);
        var library = await Library.ListAsync(_userId, new LibraryQuery { Sort = LibrarySort.LastUpdated, PageSize = 100 }, ComponentToken);
        _books = library.Items.Select(e => new NoteDialog.BookOption(e.Id, e.Title)).ToList();
    }

    private async Task RefreshAsync()
    {
        _error = await LoadAsync(async () =>
        {
            _notes = await NoteService.SearchAsync(_userId, new NoteQuery(Q, TypeFilter, Entry, PageNumber ?? 1, 20), ComponentToken);
            _selected = _notes.Items.FirstOrDefault(n => n.Id == _selected?.Id) ?? _notes.Items.FirstOrDefault();
        });
    }

    private void Pick(NoteDto note)
    {
        _selected = note;
        _paneOnMobile = true;
    }

    private string Link(string? type = null, bool keepType = true) =>
        Navigation.GetUriWithQueryParameters("notes", new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(Q) ? null : Q,
            ["type"] = keepType ? Type : string.IsNullOrEmpty(type) ? null : type,
            ["entry"] = Entry,
            ["page"] = null,
        });

    private void Apply() =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("notes", new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            ["page"] = null,
        }));

    private void OnBookChanged(Guid? entry) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("notes", new Dictionary<string, object?>
        {
            ["entry"] = entry,
            ["page"] = null,
        }));

    private void GoToPage(int page) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("page", page > 1 ? page : null));

    private void OpenNew(NoteType type)
    {
        _editing = null;
        _newType = type;
        _dialogOpen = true;
    }

    private void OpenEdit(NoteDto note)
    {
        _editing = note;
        _dialogOpen = true;
    }

    private async Task AfterSaveAsync()
    {
        await LoadAsync(LoadBooksAsync);
        await RefreshAsync();
    }

    private async Task DeleteAsync(NoteDto note)
    {
        if (await _confirm.ConfirmAsync("Delete this note?", "It will be removed from your journal. This can’t be undone.", "Delete note")
            && await RunAsync(() => NoteService.DeleteAsync(_userId, note.Id, ComponentToken), "Note deleted."))
        {
            _selected = null;
            await AfterSaveAsync();
        }
    }
}
