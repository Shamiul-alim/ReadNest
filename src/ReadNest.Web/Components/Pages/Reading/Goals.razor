@page "/goals"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Analytics
@using ReadNest.Application.Goals
@using ReadNest.Application.Library
@inject GoalService GoalService
@inject StatisticsService Statistics
@inject LibraryService Library

<AppTitle Text="Reading goals" />

@if (_error is not null)
{
    <ErrorAlert Message="@_error" Title="We couldn’t load your goals" OnRetry="RefreshAsync" />
}
else if (_year is null || _goal is null)
{
    <LoadingIndicator Text="Loading your goals…" />
}
else
{
    var goal = _goal;
    <div class="rn-page">
        <PageHeader Title="Reading goals" Description="@(goal.HasGoal ? $"A gentle target for {_year}. Change it whenever life changes." : $"Set an optional target for {_year}. You can change it whenever life changes.")">
            <Actions>
                @if (_years.Count > 1)
                {
                    <div role="group" aria-label="Year" class="rn-seg">
                        @foreach (var year in _years)
                        {
                            var y = year;
                            <button type="button" aria-pressed="@(y == _year ? "true" : "false")" @onclick="() => ChangeYearAsync(y)">@y</button>
                        }
                    </div>
                }
                <button type="button" class="rn-btn @(goal.HasGoal ? "rn-btn-secondary" : "rn-btn-primary")" @onclick="OpenEditor"><Icon Name="@(goal.HasGoal ? "pencil" : "target")" />@(goal.HasGoal ? "Edit goal" : "Set a goal")</button>
            </Actions>
        </PageHeader>

        <section aria-label="Goal progress" style="display:flex; flex-wrap:wrap; align-items:center; gap:32px clamp(32px, 6vw, 72px)">
            @if (goal.HasGoal)
            {
                <GoalRing Goal="goal" />
                <div style="flex:1 1 320px; min-width:0; display:flex; flex-direction:column; gap:12px; max-width:560px">
                    <h2 class="rn-mb-0" style="font-size:clamp(28px, 3.2vw, 38px); line-height:1.1">@GoalRing.PaceText(goal).</h2>
                    <p class="rn-mb-0" style="font-size:17px; line-height:1.65">@PaceLong(goal)</p>
                    <p class="rn-mb-0 rn-subtle" style="font-size:15px">@AverageText</p>
                </div>
            }
            else
            {
                <div class="rn-card dashed" style="flex:1 1 420px; max-width:640px">
                    <h2 class="rn-mb-0">No goal for @_year yet</h2>
                    <p class="rn-mb-0" style="font-size:16px; line-height:1.6">You’ve finished <strong>@Formats.Count(goal.CompletedBooks, "book")</strong> and logged <strong>@Formats.Count(goal.PagesRead, "page")</strong> in @_year. A goal is optional: a yearly number that encourages without nagging.</p>
                    <div class="rn-actions"><button type="button" class="rn-btn rn-btn-primary" @onclick="OpenEditor"><Icon Name="target" />Set a goal</button></div>
                </div>
            }
        </section>

        @if (goal.HasGoal)
        {
            <section aria-labelledby="ms-h" class="rn-section" style="gap:18px">
                <h2 id="ms-h" class="rn-mb-0">Milestones</h2>
                <ol style="list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:18px">
                    @foreach (var milestone in Milestones(goal))
                    {
                        <li style="display:flex; align-items:center; gap:14px" @key="milestone.Need">
                            <span style="width:48px; height:48px; flex:none; border-radius:50%; display:grid; place-items:center; @(milestone.Reached ? "background:var(--color-accent-2-600); color:var(--color-accent-2-100); border:2px solid var(--color-accent-2-600)" : "background:transparent; color:var(--color-neutral-700); border:2px dashed var(--color-neutral-400)")">
                                <Icon Name="@(milestone.Reached ? "check" : "flag")" />
                            </span>
                            <span style="display:flex; flex-direction:column">
                                <span class="rn-heading" style="font-size:19px">@milestone.Label · @milestone.Need</span>
                                <span class="rn-subtle">@milestone.When</span>
                            </span>
                        </li>
                    }
                </ol>
            </section>
        }

        <div class="rn-columns">
            <section aria-labelledby="pg-h" class="rn-section" style="gap:12px">
                <h2 id="pg-h" class="rn-mb-0">Pages</h2>
                <div style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap">
                    <span class="rn-big" style="font-size:38px">@Formats.Number(goal.PagesRead)</span>
                    <span style="font-size:16px">@(goal.TargetPages is { } tp ? "of " + Formats.Count(tp, "page") : "pages logged in " + _year)</span>
                </div>
                @if (goal.TargetPages is { } targetPages)
                {
                    <ProgressBar CurrentPage="Math.Min(goal.PagesRead, targetPages)" TotalPages="targetPages" ShowLabel="false" Label="Pages toward your page goal" />
                    <span class="rn-subtle">@(goal.PagesRead >= targetPages ? "Page goal reached." : Formats.Count(targetPages - goal.PagesRead, "page") + " to go.") Counts the pages in your logged reading sessions.</span>
                }
                else
                {
                    <span class="rn-subtle">Counts the pages in your logged reading sessions. Add a page target when you edit your goal, if you like.</span>
                }
            </section>
            <section aria-labelledby="rh-h" class="rn-section" style="gap:12px">
                <h2 id="rh-h" class="rn-mb-0">Reading rhythm</h2>
                <div style="display:flex; align-items:baseline; gap:10px">
                    <span class="rn-big" style="font-size:38px">@(_streak?.Current ?? 0)</span>
                    <span style="font-size:16px">@((_streak?.Current ?? 0) == 1 ? "day in a row" : "days in a row")</span>
                </div>
                @if (_days is { Count: > 0 } days)
                {
                    <div class="rn-days" role="img" aria-label="@("Reading in the last 14 days: read on " + days.Count(d => d.Pages > 0 || d.Minutes > 0) + " of 14 days")">
                        @foreach (var day in days)
                        {
                            var read = day.Pages > 0 || day.Minutes > 0;
                            <div title="@(Formats.Long(day.Date) + (read ? ": " + Formats.Count(day.Pages, "page") : ": rest day"))">
                                <i class="@(read ? "on" : null) @(day.Date == _today ? "today" : null)"></i>
                                <span>@day.Date.ToString("ddd", CultureInfo.CurrentCulture)[..1]</span>
                            </div>
                        }
                    </div>
                }
                <span class="rn-subtle">Rest days are part of reading. Missing one never resets your goal. @(_streak is { Longest: > 0 } s ? "Your longest run is " + Formats.Count(s.Longest, "day") + "." : "")</span>
            </section>
        </div>

        @if (_months is { } months)
        {
            var max = Math.Max(1, Math.Max(months.Max(m => m.BooksCompleted), goal.HasGoal ? (int)Math.Ceiling(goal.TargetBooks / 12.0) : 0));
            var pace = goal.HasGoal ? goal.TargetBooks / 12.0 : 0;
            <section aria-labelledby="bm-h" class="rn-section">
                <div class="rn-section-header">
                    <h2 id="bm-h">Books finished each month</h2>
                    @if (goal.HasGoal)
                    {
                        <span class="rn-legend"><span><i class="dash"></i>Pace for @goal.TargetBooks: about @pace.ToString("0.#", CultureInfo.CurrentCulture) a month</span></span>
                    }
                </div>
                <div class="rn-months" role="img" aria-label="@MonthsSummary(months)">
                    @if (goal.HasGoal)
                    {
                        <div class="rn-pace-line" aria-hidden="true" style="bottom:@((pace / max * 130).ToString("0", CultureInfo.InvariantCulture))px"></div>
                    }
                    @foreach (var month in months)
                    {
                        var isCurrent = month.Year == _today.Year && month.Month == _today.Month;
                        <div class="rn-months-col" title="@(month.LongLabel + ": " + Formats.Count(month.BooksCompleted, "book"))">
                            <span class="n">@(month.BooksCompleted > 0 ? month.BooksCompleted.ToString(CultureInfo.CurrentCulture) : "")</span>
                            <div class="bar @(month.BooksCompleted == 0 ? "zero" : isCurrent ? "current" : null)" style="height:@(month.BooksCompleted == 0 ? "3px" : (month.BooksCompleted * 130 / max) + "px")"></div>
                        </div>
                    }
                </div>
                <div class="rn-month-labels">
                    @foreach (var month in months)
                    {
                        <span>@month.Label</span>
                    }
                </div>
            </section>
        }

        @if (_completed.Count > 0)
        {
            <section aria-labelledby="fin-h" class="rn-section" style="gap:8px; max-width:760px">
                <h2 id="fin-h" class="rn-mb-0" style="margin-bottom:6px">Finished in @_year</h2>
                @foreach (var book in _completed)
                {
                    <a class="rn-row-link" href="@("books/" + book.BookId)" @key="book.EntryId">
                        <BookCover Title="@book.Title" Author="@(book.Authors.Count > 0 ? book.Authors[0] : null)" Url="@book.CoverUrl" Size="xs" />
                        <span class="rn-list-body">
                            <span class="rn-list-title">@book.Title</span>
                            <span class="rn-subtle">@(book.Authors.Count > 0 ? string.Join(", ", book.Authors) : "Unknown author")</span>
                        </span>
                        <span style="flex:none; display:flex; flex-direction:column; align-items:flex-end; gap:4px">
                            <Stars Value="book.Rating" IconSize="14" />
                            <span class="rn-small rn-muted">@Formats.Short(book.CompletedOn, _today)</span>
                        </span>
                    </a>
                }
            </section>
        }
    </div>

    <Modal Title="@($"Your {_year} goal")" @bind-Open="_editorOpen">
        <ChildContent>
            <form id="goal-form" @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate style="display:flex; flex-direction:column; gap:16px">
                <div class="rn-field">
                    <label class="rn-label" for="goal-books" style="font-size:15px">Books this year</label>
                    <div style="display:flex; align-items:center; gap:10px">
                        <button type="button" class="rn-btn rn-btn-secondary rn-btn-icon lg" aria-label="One fewer" @onclick="() => Step(-1)"><Icon Name="minus" /></button>
                        <input id="goal-books" data-autofocus class="rn-input big-number @(BooksError is null ? null : "invalid")" style="width:120px; min-height:60px; font-size:30px" type="number" inputmode="numeric" min="1" max="1000"
                               value="@_targetText" @oninput="OnBooksInput" aria-invalid="@(BooksError is null ? "false" : "true")" />
                        <button type="button" class="rn-btn rn-btn-secondary rn-btn-icon lg" aria-label="One more" @onclick="() => Step(1)"><Icon Name="plus" /></button>
                    </div>
                </div>
                @if (BooksError is { } booksError)
                {
                    <span class="rn-error-text" role="alert"><Icon Name="alert" />@booksError</span>
                }
                else
                {
                    <span style="font-size:15px; line-height:1.55">@Hint</span>
                }
                <div class="rn-field">
                    <label class="rn-label" for="goal-pages">Pages this year <span class="optional">(optional)</span></label>
                    <input id="goal-pages" class="rn-input @(PagesError is null ? null : "invalid")" type="number" inputmode="numeric" min="1" value="@_pagesText" @oninput="OnPagesInput" />
                </div>
                @if (PagesError is { } pagesError)
                {
                    <span class="rn-error-text" role="alert"><Icon Name="alert" />@pagesError</span>
                }
            </form>
        </ChildContent>
        <Footer>
            @if (goal.HasGoal)
            {
                <button type="button" class="rn-btn rn-btn-ghost push" disabled="@IsBusy" @onclick="DeleteAsync"><Icon Name="trash" />Remove goal</button>
            }
            <button type="button" class="rn-btn rn-btn-secondary" @onclick="() => _editorOpen = false">Cancel</button>
            <button type="submit" form="goal-form" class="rn-btn rn-btn-primary" disabled="@(IsBusy || BooksError is not null || PagesError is not null)">Save goal</button>
        </Footer>
    </Modal>
    <ConfirmDialog @ref="_confirm" />
}

@code {
    private sealed record Milestone(string Label, int Need, bool Reached, string When);

    private Guid _userId;
    private DateOnly _today;
    private int? _year;
    private List<int> _years = [];
    private GoalProgressDto? _goal;
    private IReadOnlyList<MonthlyActivityDto>? _months;
    private IReadOnlyList<CompletedBookDto> _completed = [];
    private IReadOnlyList<DailyActivityDto>? _days;
    private StreakResult? _streak;
    private string? _error;
    private bool _editorOpen;
    private string _targetText = "";
    private string _pagesText = "";
    private ConfirmDialog _confirm = default!;

    private int? TargetValue => int.TryParse(_targetText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : null;
    private int? PagesValue => int.TryParse(_pagesText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : null;

    private string? BooksError => TargetValue switch
    {
        null => "Enter how many books you’d like to finish.",
        < 1 => "A goal needs at least 1 book.",
        > 1000 => "Goals can be up to 1,000 books.",
        _ => null,
    };

    private string? PagesError => string.IsNullOrWhiteSpace(_pagesText) ? null : PagesValue is null or < 1 ? "Enter a page target above 0, or leave it empty." : null;

    private string Hint
    {
        get
        {
            var target = TargetValue ?? 0;
            if (target <= 0)
            {
                return "";
            }

            var days = DateTime.IsLeapYear(_year!.Value) ? 366 : 365;
            var every = days / (double)target;
            return every >= 1
                ? $"That’s about one every {Math.Round(every):0} days across the year."
                : $"That’s about {Math.Round(target / (double)days, 1):0.#} a day across the year.";
        }
    }

    private string AverageText
    {
        get
        {
            if (_goal is not { CompletedBooks: > 0 } goal || _year != _today.Year)
            {
                return _goal is { } g && _year < _today.Year ? $"You finished {Formats.Count(g.CompletedBooks, "book")} in {_year}." : "Your first finished book will set the pace.";
            }

            var perMonth = Math.Round(goal.CompletedBooks / Math.Max(1.0, _today.DayOfYear / 30.4), 1);
            return $"So far you’re finishing about {perMonth.ToString("0.#", CultureInfo.CurrentCulture)} {(perMonth == 1 ? "book" : "books")} a month.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _error = await LoadAsync(async () =>
        {
            _userId = await RequireUserIdAsync();
            _today = await Library.GetTodayAsync(_userId, ComponentToken);
            _year = _today.Year;
            var goals = await GoalService.ListAsync(_userId, ComponentToken);
            _years = goals.Select(g => g.Year).Append(_today.Year).Distinct().OrderDescending().Take(6).ToList();
        });
        if (_error is null)
        {
            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (_year is not { } year)
        {
            return;
        }

        _error = await LoadAsync(async () =>
        {
            var analytics = await Statistics.GetYearAnalyticsAsync(_userId, year, ComponentToken);
            _goal = analytics.Goal;
            _months = analytics.Months;
            _streak = analytics.Streak;
            _completed = await Statistics.GetCompletedBooksAsync(_userId, year, ComponentToken);
            _days ??= await Statistics.GetDailyActivityAsync(_userId, 14, ComponentToken);
        });
    }

    private async Task ChangeYearAsync(int year)
    {
        _year = year;
        await RefreshAsync();
    }

    private string PaceLong(GoalProgressDto goal)
    {
        if (goal.Pace == GoalPace.Completed)
        {
            return $"You’ve finished all {goal.TargetBooks} books you planned for {_year}. Anything more is a bonus.";
        }

        if (_year != _today.Year)
        {
            return _year < _today.Year
                ? $"You finished {goal.CompletedBooks} of {goal.TargetBooks} books in {_year}."
                : $"This goal starts on January 1, {_year}.";
        }

        var expected = goal.ExpectedByToday;
        return $"{Formats.Count(goal.RemainingBooks, "book")} to go. By today, a steady pace would be {expected} {(expected == 1 ? "book" : "books")}; you’ve finished {goal.CompletedBooks}. A book counts the day you finish it.";
    }

    private IEnumerable<Milestone> Milestones(GoalProgressDto goal)
    {
        var finished = _completed.OrderBy(b => b.CompletedOn).ToList();
        var steps = new (string Label, double Fraction)[] { ("Quarter", .25), ("Halfway", .5), ("Three quarters", .75), ("Goal", 1) };
        var seen = new HashSet<int>();
        var perDay = _year == _today.Year && goal.CompletedBooks > 0 ? goal.CompletedBooks / (double)_today.DayOfYear : 0;
        foreach (var (label, fraction) in steps)
        {
            var need = Math.Max(1, (int)Math.Ceiling(goal.TargetBooks * fraction));
            if (!seen.Add(need))
            {
                continue;
            }

            if (finished.Count >= need)
            {
                yield return new Milestone(label, need, true, "Reached " + Formats.Short(finished[need - 1].CompletedOn, _today));
            }
            else if (perDay > 0)
            {
                var date = _today.AddDays((int)Math.Ceiling((need - goal.CompletedBooks) / perDay));
                yield return new Milestone(label, need, false, date.Year == _year ? "Around " + Formats.Short(date, _today) + " at your pace" : "Beyond this year at your pace");
            }
            else
            {
                yield return new Milestone(label, need, false, Formats.Count(need - goal.CompletedBooks, "book") + " to go");
            }
        }
    }

    private static string MonthsSummary(IReadOnlyList<MonthlyActivityDto> months)
    {
        var best = months.MaxBy(m => m.BooksCompleted);
        return "Books finished per month. Total " + Formats.Count(months.Sum(m => m.BooksCompleted), "book") +
            (best is { BooksCompleted: > 0 } ? ". Busiest month: " + best.LongLabel + " with " + Formats.Count(best.BooksCompleted, "book") + "." : ".");
    }

    private void OpenEditor()
    {
        _targetText = (_goal is { HasGoal: true } g ? g.TargetBooks : 12).ToString(CultureInfo.InvariantCulture);
        _pagesText = _goal?.TargetPages?.ToString(CultureInfo.InvariantCulture) ?? "";
        _editorOpen = true;
    }

    private void OnBooksInput(ChangeEventArgs e) => _targetText = e.Value?.ToString() ?? "";

    private void OnPagesInput(ChangeEventArgs e) => _pagesText = e.Value?.ToString() ?? "";

    private void Step(int delta) => _targetText = Math.Clamp((TargetValue ?? 0) + delta, 1, 1000).ToString(CultureInfo.InvariantCulture);

    private async Task SaveAsync()
    {
        if (BooksError is not null || PagesError is not null || _year is not { } year)
        {
            return;
        }

        var request = new GoalRequest(TargetValue!.Value, PagesValue);
        if (await RunAsync(() => GoalService.SetGoalAsync(_userId, year, request, ComponentToken), $"Your {year} goal is {Formats.Count(request.TargetBooks, "book")}."))
        {
            _editorOpen = false;
            if (!_years.Contains(year))
            {
                _years.Add(year);
            }

            await RefreshAsync();
        }
    }

    private async Task DeleteAsync()
    {
        if (_year is not { } year)
        {
            return;
        }

        _editorOpen = false;
        if (await _confirm.ConfirmAsync($"Remove your {year} goal?", "Your reading history and finished books are not affected.", "Remove goal")
            && await RunAsync(() => GoalService.DeleteGoalAsync(_userId, year, ComponentToken), "Goal removed."))
        {
            await RefreshAsync();
        }
    }
}
