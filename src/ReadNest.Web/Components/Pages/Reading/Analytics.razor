@page "/analytics"
@attribute [Authorize]
@rendermode AppRenderMode.Interactive
@inherits ReadNestComponentBase
@using ReadNest.Application.Analytics
@using ReadNest.Application.Library
@inject StatisticsService Statistics
@inject LibraryService Library

<AppTitle Text="Insights" />

@if (_error is not null)
{
    <ErrorAlert Message="@_error" Title="We couldn’t load your insights" OnRetry="RefreshAsync" />
}
else if (_data is null || _counts is null)
{
    <LoadingIndicator Text="Gathering your reading…" />
}
else if (IsEmpty)
{
    var ratings = _data.RatingDistribution.Sum();
    <div class="rn-page tight">
        <div style="display:flex; flex-direction:column; gap:8px">
            <h1 class="rn-mb-0" tabindex="-1">Insights</h1>
            <p class="rn-mb-0" style="font-size:16px; color:var(--color-neutral-700)">These grow with your reading. Here’s what you’ll see and when.</p>
        </div>
        <div class="rn-grid rn-grid-4">
            @Unlock("Reading calendar", "Appears after your first logged session.", _sessionsLogged, 1, "session")
            @Unlock("Monthly trends", "Appear once you’ve finished three books.", _counts.Read, 3, "book")
            @Unlock("Genres and authors", "Appear once you’ve rated five books.", ratings, 5, "rating")
        </div>
        <p class="rn-subtle rn-mb-0">Updating your page records a session automatically, so the calendar fills in as you read.</p>
    </div>
}
else
{
    var data = _data;
    <div class="rn-page">
        <PageHeader Title="Insights" Description="@Headline">
            <Actions>
                @if (data.AvailableYears.Count > 1)
                {
                    <div role="group" aria-label="Year" class="rn-seg">
                        @foreach (var year in data.AvailableYears.Take(5))
                        {
                            var y = year;
                            <button type="button" aria-pressed="@(y == data.Year ? "true" : "false")" style="font-weight:700" @onclick="() => ChangeYearAsync(y)">@y</button>
                        }
                    </div>
                }
                <a class="rn-btn rn-btn-ghost" href="history"><Icon Name="clock" />All sessions</a>
            </Actions>
        </PageHeader>

        <div class="rn-grid" style="grid-template-columns:repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap:28px">
            @foreach (var (kicker, text) in Statements(data))
            {
                <div class="rn-insight"><span>@kicker</span><span>@text</span></div>
            }
        </div>

        <div class="rn-columns">
            <section aria-labelledby="bym-h" class="rn-section" style="gap:14px">
                <h2 id="bym-h" class="rn-mb-0">Books by month</h2>
                <div class="rn-legend">
                    <span><i style="background:var(--color-accent-2-600)"></i>@data.Year</span>
                    @if (_previous is not null)
                    {
                        <span><i style="background:var(--color-neutral-400)"></i>@(data.Year - 1)</span>
                    }
                </div>
                @{
                    var max = Math.Max(1, Math.Max(data.Months.Max(m => m.BooksCompleted), _previous?.Max(m => m.BooksCompleted) ?? 0));
                }
                <div class="rn-months" style="height:170px; padding-top:6px" role="img" aria-label="@CompareSummary(data)">
                    @for (var i = 0; i < data.Months.Count; i++)
                    {
                        var month = data.Months[i];
                        var prev = _previous is { } p && i < p.Count ? p[i] : null;
                        <div class="rn-months-pair" title="@(month.LongLabel + ": " + Formats.Count(month.BooksCompleted, "book") + (prev is null ? "" : "; " + prev.LongLabel + ": " + Formats.Count(prev.BooksCompleted, "book")))">
                            <div class="bar" style="height:@(month.BooksCompleted * 160 / max)px"></div>
                            @if (prev is not null)
                            {
                                <div class="bar prev" style="height:@(prev.BooksCompleted * 160 / max)px"></div>
                            }
                        </div>
                    }
                </div>
                <div class="rn-month-labels" style="gap:clamp(3px, .8vw, 10px)">
                    @foreach (var month in data.Months)
                    {
                        <span>@month.Label</span>
                    }
                </div>
            </section>
            <section aria-labelledby="pot-h" class="rn-section" style="gap:14px">
                <h2 id="pot-h" class="rn-mb-0">Pages over time</h2>
                @{
                    var peak = data.Months.MaxBy(m => m.Pages);
                }
                <div class="rn-subtle">@Formats.Count(data.PagesRead, "page") logged in @data.Year@(peak is { Pages: > 0 } ? " · busiest month " + peak.LongLabel.Split(' ')[0] : "")</div>
                <svg viewBox="0 0 600 190" preserveAspectRatio="none" width="100%" height="170" role="img" aria-label="@("Line chart of pages logged each month in " + data.Year + ". Total " + Formats.Count(data.PagesRead, "page") + ".")">
                    <path d="@AreaPath(data.Months)" style="fill:var(--color-accent-2-200)"></path>
                    <path d="@LinePath(data.Months)" style="fill:none; stroke:var(--color-accent-2-700); stroke-width:3; stroke-linejoin:round; vector-effect:non-scaling-stroke"></path>
                </svg>
                <div class="rn-month-labels" style="gap:0">
                    @foreach (var month in data.Months)
                    {
                        <span>@month.Label</span>
                    }
                </div>
            </section>
        </div>

        @if (_days is { } days)
        {
            <section aria-labelledby="cal-h" class="rn-section" style="gap:14px">
                <div class="rn-section-header">
                    <h2 id="cal-h">Reading calendar</h2>
                    <span class="rn-legend" style="gap:5px; font-size:13px">Less<i style="background:var(--color-neutral-200)"></i><i style="background:var(--color-accent-2-200)"></i><i style="background:var(--color-accent-2-400)"></i><i style="background:var(--color-accent-2-600)"></i><i style="background:var(--color-accent-2-800)"></i>More</span>
                </div>
                <div class="rn-heat" role="img" aria-label="@HeatSummary(days)">
                    @for (var i = 0; i < LeadingBlanks(days); i++)
                    {
                        <span class="out"></span>
                    }
                    @foreach (var day in days)
                    {
                        <span class="@HeatLevel(day)" title="@(Formats.Long(day.Date) + ": " + (day.Minutes > 0 ? Formats.Duration(day.Minutes) : day.Pages > 0 ? Formats.Count(day.Pages, "page") : "no reading"))"></span>
                    }
                </div>
                <div class="rn-axis" style="max-width:900px"><span>@days[0].Date.ToString("MMM yyyy", CultureInfo.CurrentCulture)</span><span>Today</span></div>
            </section>
        }

        <div class="rn-columns">
            <section aria-labelledby="gen-h" class="rn-section" style="gap:14px">
                <h2 id="gen-h" class="rn-mb-0">Favourite genres</h2>
                @if (data.TopGenres.Count == 0)
                {
                    <p class="rn-subtle rn-mb-0">@(data.BooksCompleted >= StatisticsService.MinimumBooksForTasteStats
                        ? "Your finished books don’t have subjects yet. Books added from the catalogue bring their subjects with them."
                        : $"Finish at least {StatisticsService.MinimumBooksForTasteStats} books in {data.Year} to see your genres.")</p>
                }
                else
                {
                    var total = Math.Max(1, data.TopGenres.Sum(g => g.Count));
                    var top = Math.Max(1, data.TopGenres.Max(g => g.Count));
                    @foreach (var genre in data.TopGenres.Take(6))
                    {
                        <div class="rn-hbar">
                            <div class="rn-hbar-head"><span>@genre.Name</span><span>@Formats.Count(genre.Count, "book") · @((genre.Count * 100 / total).ToString(CultureInfo.InvariantCulture))%</span></div>
                            <div class="rn-hbar-track"><span style="width:@((genre.Count * 100 / top).ToString(CultureInfo.InvariantCulture))%"></span></div>
                        </div>
                    }
                }
            </section>
            <section aria-labelledby="au-h" class="rn-section" style="gap:12px">
                <h2 id="au-h" class="rn-mb-0">Most-read authors</h2>
                @if (data.TopAuthors.Count == 0)
                {
                    <p class="rn-subtle rn-mb-0">Your favourite authors appear once you’ve finished or rated a few of their books.</p>
                }
                else
                {
                    <ol class="rn-rank">
                        @for (var i = 0; i < Math.Min(5, data.TopAuthors.Count); i++)
                        {
                            var author = data.TopAuthors[i];
                            <li><span class="rn-rank-n">@(i + 1)</span><span>@author.Name</span><span>@Formats.Count(author.Count, "book")</span></li>
                        }
                    </ol>
                }
            </section>
            @if (_outcomes is { Total: > 0 } outcomes)
            {
                <section aria-labelledby="cmp-h" class="rn-section" style="gap:14px">
                    <h2 id="cmp-h" class="rn-mb-0">What happens to books you start</h2>
                    <div class="rn-stacked" role="img" aria-label="@OutcomeSummary(outcomes)">
                        @foreach (var part in Parts(outcomes).Where(p => p.Count > 0))
                        {
                            <div style="width:@((part.Count * 100.0 / outcomes.Total).ToString("0.#", CultureInfo.InvariantCulture))%; background:@part.Color" title="@(part.Label + ": " + part.Count)"></div>
                        }
                    </div>
                    <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px">
                        @foreach (var part in Parts(outcomes))
                        {
                            <li style="display:flex; align-items:center; gap:10px; font-size:15px"><span style="width:12px; height:12px; border-radius:50%; background:@part.Color"></span><span style="flex:1">@part.Label</span><span style="font-weight:700">@part.Count</span></li>
                        }
                    </ul>
                    <span class="rn-subtle">Books you started in @data.Year.</span>
                </section>
            }
        </div>
    </div>
}

@code {
    private sealed record Part(string Label, int Count, string Color);

    private Guid _userId;
    private int? _year;
    private YearAnalyticsDto? _data;
    private IReadOnlyList<MonthlyActivityDto>? _previous;
    private IReadOnlyList<DailyActivityDto>? _days;
    private StartOutcomesDto? _outcomes;
    private StatusCountsDto? _counts;
    private int _sessionsLogged;
    private string? _error;

    private bool IsEmpty => _sessionsLogged == 0 && _counts is { Read: 0 };

    private string Headline =>
        $"{Formats.Count(_data!.BooksCompleted, "book")} and {Formats.Count(_data.PagesRead, "page")} {(_data.Year == DateTime.UtcNow.Year ? "so far in" : "in")} {_data.Year}.";

    protected override async Task OnInitializedAsync()
    {
        _userId = await RequireUserIdAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _error = await LoadAsync(async () =>
        {
            var year = _year ??= (await Library.GetTodayAsync(_userId, ComponentToken)).Year;
            _data = await Statistics.GetYearAnalyticsAsync(_userId, year, ComponentToken);
            _previous = _data.AvailableYears.Contains(year - 1)
                ? (await Statistics.GetYearAnalyticsAsync(_userId, year - 1, ComponentToken)).Months
                : null;
            _days ??= await Statistics.GetDailyActivityAsync(_userId, 182, ComponentToken);
            _outcomes = await Statistics.GetStartOutcomesAsync(_userId, year, ComponentToken);
            _counts = await Library.GetStatusCountsAsync(_userId, ComponentToken);
            _sessionsLogged = _days.Count(d => d.Pages > 0 || d.Minutes > 0) + _data.Sessions;
        });
    }

    private async Task ChangeYearAsync(int year)
    {
        _year = year;
        await RefreshAsync();
    }

    private static RenderFragment Unlock(string title, string text, int have, int need, string unit) => __builder =>
    {
        <div class="rn-card" style="gap:10px; padding:26px">
            <span class="rn-heading" style="font-size:20px">@title</span>
            <span style="font-size:15px; line-height:1.55">@text</span>
            <ProgressBar CurrentPage="Math.Min(have, need)" TotalPages="need" ShowLabel="false" Size="md" Label="@title" />
            <span class="rn-small rn-muted">@Math.Min(have, need) of @Formats.Count(need, unit)</span>
        </div>
    };

    private static IEnumerable<(string Kicker, string Text)> Statements(YearAnalyticsDto data)
    {
        var busiest = data.Months.MaxBy(m => m.BooksCompleted);
        if (busiest is { BooksCompleted: > 0 })
        {
            yield return ("Your busiest month", $"{busiest.LongLabel.Split(' ')[0]}, with {Formats.Count(busiest.BooksCompleted, "book")} finished.");
        }

        if (data.AverageRating is { } average)
        {
            yield return ("How you rated", $"{average.ToString("0.#", CultureInfo.CurrentCulture)} stars on average across {Formats.Count(data.RatingDistribution.Sum(), "rated book")}.");
        }

        if (data.ReadingDays > 0)
        {
            yield return ("Reading days", $"You read on {Formats.Count(data.ReadingDays, "day")}, about {data.AveragePagesPerReadingDay.ToString("0", CultureInfo.CurrentCulture)} pages each time.");
        }

        if (data.LongestBook is { Pages: { } pages } longest)
        {
            yield return ("Longest book", $"{longest.Title}, at {Formats.Count(pages, "page")}.");
        }
    }

    private string CompareSummary(YearAnalyticsDto data) =>
        $"Books finished per month in {data.Year}: {Formats.Count(data.BooksCompleted, "book")} in total" +
        (_previous is { } prev ? $", compared with {Formats.Count(prev.Sum(m => m.BooksCompleted), "book")} in {data.Year - 1}." : ".");

    private static (double X, double Y)[] Points(IReadOnlyList<MonthlyActivityDto> months)
    {
        var max = Math.Max(1, months.Max(m => m.Pages));
        return months.Select((m, i) => (X: months.Count == 1 ? 300 : i * 600.0 / (months.Count - 1), Y: 182 - m.Pages * 170.0 / max)).ToArray();
    }

    private static string LinePath(IReadOnlyList<MonthlyActivityDto> months) =>
        "M" + string.Join(" L", Points(months).Select(p => p.X.ToString("0.#", CultureInfo.InvariantCulture) + "," + p.Y.ToString("0.#", CultureInfo.InvariantCulture)));

    private static string AreaPath(IReadOnlyList<MonthlyActivityDto> months) => LinePath(months) + " L600,190 L0,190 Z";

    /// <summary>Blank cells so every heatmap column starts on a Monday.</summary>
    private static int LeadingBlanks(IReadOnlyList<DailyActivityDto> days) => ((int)days[0].Date.DayOfWeek + 6) % 7;

    private static string HeatLevel(DailyActivityDto day)
    {
        var amount = day.Minutes > 0 ? day.Minutes : day.Pages;
        return amount switch { 0 => "", < 20 => "h1", < 40 => "h2", < 70 => "h3", _ => "h4" };
    }

    private static string HeatSummary(IReadOnlyList<DailyActivityDto> days)
    {
        var active = days.Count(d => d.Minutes > 0 || d.Pages > 0);
        return $"Daily reading over the last {days.Count / 7} weeks: you read on {Formats.Count(active, "day")}, logging {Formats.Duration(days.Sum(d => d.Minutes))}.";
    }

    private static IEnumerable<Part> Parts(StartOutcomesDto outcomes) =>
    [
        new("Finished", outcomes.Finished, "var(--color-accent-2-600)"),
        new("Still reading", outcomes.StillReading, "var(--color-accent-500)"),
        new("Paused", outcomes.Paused, "var(--color-accent-300)"),
        new("Did not finish", outcomes.DidNotFinish, "var(--color-neutral-400)"),
    ];

    private static string OutcomeSummary(StartOutcomesDto o) =>
        $"Of {Formats.Count(o.Total, "book")} started in {o.Year}: {o.Finished} finished, {o.StillReading} still reading, {o.Paused} paused, {o.DidNotFinish} not finished.";
}
