@inherits LayoutComponentBase
@using ReadNest.Application.Library
@using ReadNest.Application.Social
@using ReadNest.Web.Authorization
@inject ProfileService Profiles
@inject LibraryService Library

<a class="rn-skip-link visually-hidden-focusable" href="#main-content">Skip to main content</a>

<div class="rn-shell">
    <input type="checkbox" id="rn-nav-toggle" class="rn-nav-toggle" tabindex="-1" aria-hidden="true" />
    <aside class="rn-sidebar" id="rn-sidebar" aria-label="Main navigation">
        <a class="rn-brand" href="@(_userId is null ? "" : "dashboard")">
            <span class="rn-brand-mark"><Icon Name="book" /></span>
            <span class="rn-brand-name">ReadNest</span>
        </a>

        @if (_userId is not null)
        {
            <nav>
                <div class="rn-nav-section rn-mt-0">
                    <NavLink class="rn-nav-link" href="dashboard" Match="NavLinkMatch.All"><Icon Name="dashboard" /> Dashboard</NavLink>
                    <NavLink class="rn-nav-link" href="explore"><Icon Name="compass" /> Explore books</NavLink>
                    <NavLink class="rn-nav-link" href="recommendations"><Icon Name="sparkles" /> For you</NavLink>
                </div>
                <div class="rn-nav-section">
                    <div class="rn-nav-heading">My library</div>
                    <NavLink class="rn-nav-link" href="library" Match="NavLinkMatch.All"><Icon Name="library" /> All books <span class="rn-nav-count">@_counts?.Total</span></NavLink>
                    <NavLink class="rn-nav-link" href="library/want-to-read"><Icon Name="bookmark" /> Want to Read <span class="rn-nav-count">@_counts?.WantToRead</span></NavLink>
                    <NavLink class="rn-nav-link" href="library/currently-reading"><Icon Name="book" /> Currently Reading <span class="rn-nav-count">@_counts?.CurrentlyReading</span></NavLink>
                    <NavLink class="rn-nav-link" href="library/read"><Icon Name="check-circle" /> Read <span class="rn-nav-count">@_counts?.Read</span></NavLink>
                    <NavLink class="rn-nav-link" href="library/paused"><Icon Name="pause" /> Paused &amp; DNF <span class="rn-nav-count">@(_counts is null ? null : _counts.Paused + _counts.DidNotFinish)</span></NavLink>
                    <NavLink class="rn-nav-link" href="shelves"><Icon Name="layers" /> Custom shelves</NavLink>
                    <NavLink class="rn-nav-link" href="collection"><Icon Name="archive" /> Collection &amp; loans</NavLink>
                </div>
                <div class="rn-nav-section">
                    <div class="rn-nav-heading">Reading</div>
                    <NavLink class="rn-nav-link" href="notes"><Icon Name="pen" /> Notes &amp; journal</NavLink>
                    <NavLink class="rn-nav-link" href="history"><Icon Name="clock" /> Reading history</NavLink>
                    <NavLink class="rn-nav-link" href="goals"><Icon Name="target" /> Goals</NavLink>
                    <NavLink class="rn-nav-link" href="analytics"><Icon Name="chart" /> Analytics</NavLink>
                    <NavLink class="rn-nav-link" href="reviews"><Icon Name="star" /> My reviews</NavLink>
                </div>
                <div class="rn-nav-section">
                    <div class="rn-nav-heading">Community</div>
                    <NavLink class="rn-nav-link" href="community"><Icon Name="users" /> Readers &amp; reviews</NavLink>
                    <NavLink class="rn-nav-link" href="challenges"><Icon Name="trophy" /> Challenges</NavLink>
                </div>
            </nav>
        }
        else
        {
            <nav>
                <div class="rn-nav-section rn-mt-0">
                    <NavLink class="rn-nav-link" href="" Match="NavLinkMatch.All"><Icon Name="dashboard" /> Home</NavLink>
                    <NavLink class="rn-nav-link" href="explore"><Icon Name="compass" /> Explore books</NavLink>
                    <NavLink class="rn-nav-link" href="community"><Icon Name="users" /> Readers &amp; reviews</NavLink>
                    <NavLink class="rn-nav-link" href="challenges"><Icon Name="trophy" /> Challenges</NavLink>
                </div>
                <div class="rn-nav-section">
                    <a class="rn-btn rn-btn-primary rn-btn-block" href="Account/Register">Create a free account</a>
                    <a class="rn-btn rn-btn-ghost rn-btn-block mt-2" href="Account/Login">Log in</a>
                </div>
            </nav>
        }
        <div class="rn-sidebar-footer">Book data from Google Books and Open Library.</div>
    </aside>
    <label for="rn-nav-toggle" class="rn-sidebar-backdrop" aria-hidden="true"></label>

    <div class="rn-main">
        <header class="rn-topbar">
            <button type="button" class="rn-btn rn-btn-ghost rn-btn-icon rn-menu-button" data-nav-toggle aria-controls="rn-sidebar" aria-label="Open navigation menu">
                <Icon Name="menu" />
            </button>
            <form class="rn-topbar-search" action="explore" method="get" role="search">
                <Icon Name="search" />
                <input type="search" name="q" maxlength="200" placeholder="Search books by title, author or ISBN…" aria-label="Search the book catalogue" />
            </form>
            <div class="rn-topbar-actions">
                @if (_userId is not null)
                {
                    <details class="rn-account">
                        <summary aria-label="Account menu">
                            <Avatar Name="@_profile?.DisplayName" ImageUrl="@_profile?.ProfileImageUrl" />
                            <span class="d-none d-md-inline rn-truncate" style="max-width:140px">@_profile?.DisplayName</span>
                        </summary>
                        <div class="rn-account-menu">
                            <div class="px-2 py-1 rn-subtle">Signed in as <strong>@@@_profile?.Handle</strong></div>
                            <hr />
                            <a href="profile"><Icon Name="user" /> Profile</a>
                            <a href="settings"><Icon Name="settings" /> Settings</a>
                            <a href="import-export"><Icon Name="download" /> Import &amp; export</a>
                            <a href="Account/Manage"><Icon Name="lock" /> Account &amp; security</a>
                            <hr />
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit"><Icon Name="logout" /> Log out</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a class="rn-btn rn-btn-ghost" href="Account/Login">Log in</a>
                    <a class="rn-btn rn-btn-primary" href="Account/Register">Sign up</a>
                }
            </div>
        </header>

        <main id="main-content" class="rn-content">
            @Body
        </main>
    </div>
</div>

<ToastHost @rendermode="AppRenderMode.Interactive" />

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" role="button" aria-label="Dismiss">✕</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid? _userId;
    private ProfileDto? _profile;
    private StatusCountsDto? _counts;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var user = (await AuthenticationStateTask).User;
        _userId = user.TryGetUserId();
        if (_userId is { } userId)
        {
            // Ensures every account has a profile, including accounts created through the token API.
            _profile = await Profiles.GetOrCreateAsync(userId, user.Identity?.Name?.Split('@')[0], null, CancellationToken.None);
            _counts = await Library.GetStatusCountsAsync(userId, CancellationToken.None);
        }
    }
}
