@inherits LayoutComponentBase

<a class="rn-skip-link visually-hidden-focusable" href="#main-content">Skip to main content</a>
<div class="rn-auth">
    <aside class="rn-auth-aside">
        <a class="rn-brand" href="">
            <span class="rn-brand-mark"><Icon Name="book" /></span>
            <span class="rn-brand-name">ReadNest</span>
        </a>
        <div>
            <h2>Your reading life, organised.</h2>
            <p>Track what you read, keep the ideas worth remembering, and build a habit that lasts.</p>
        </div>
        <p class="rn-mb-0" style="opacity:.8">“A reader lives a thousand lives before he dies.” — George R. R. Martin</p>
    </aside>
    <main class="rn-auth-main" id="main-content">
        <div class="rn-auth-card">
            <a class="rn-brand d-lg-none ps-0" href="">
                <span class="rn-brand-mark"><Icon Name="book" /></span>
                <span class="rn-brand-name">ReadNest</span>
            </a>
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" role="button" aria-label="Dismiss">✕</span>
</div>
