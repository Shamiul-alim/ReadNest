@inherits LayoutComponentBase

<a class="rn-skip-link visually-hidden-focusable" href="#main-content">Skip to main content</a>
<div class="rn-auth">
    <div class="rn-auth-main">
        <a class="rn-brand" href="" aria-label="ReadNest home">
            <Logo />
            <span class="rn-brand-name" style="font-size:22px">ReadNest</span>
        </a>
        <main class="rn-auth-center" id="main-content" tabindex="-1">
            <div class="rn-auth-card">
                @Body
            </div>
        </main>
    </div>
    @* Decorative panel, desktop only. *@
    <div class="rn-auth-aside" aria-hidden="true">
        <div class="blob"></div>
        <div class="c1"><BookCover Title="Piranesi" Author="Susanna Clarke" Isbn="9781635575637" Shadow="lg" /></div>
        <div class="c2"><BookCover Title="Middlemarch" Author="George Eliot" Isbn="9780141439549" Shadow="lg" /></div>
        <div class="copy">
            <span>Page 164 of 272. Right where you left it.</span>
            <span>Your place, your notes and your shelves, waiting.</span>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" role="button" aria-label="Dismiss">✕</span>
</div>
