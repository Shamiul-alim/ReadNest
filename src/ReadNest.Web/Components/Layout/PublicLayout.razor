@inherits LayoutComponentBase

<a class="rn-skip-link visually-hidden-focusable" href="#main-content">Skip to main content</a>
<header class="rn-public-nav">
    <a class="rn-brand ps-0" href="">
        <span class="rn-brand-mark"><Icon Name="book" /></span>
        <span class="rn-brand-name">ReadNest</span>
    </a>
    <nav aria-label="Main">
        <a href="explore" class="hide-sm">Explore books</a>
        <a href="community" class="hide-sm">Community</a>
        <AuthorizeView>
            <Authorized>
                <a class="rn-btn rn-btn-primary" href="dashboard">Open my dashboard</a>
            </Authorized>
            <NotAuthorized>
                <a href="Account/Login">Log in</a>
                <a class="rn-btn rn-btn-primary" href="Account/Register">Sign up free</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>
<main id="main-content">
    @Body
</main>
<footer class="rn-footer">
    ReadNest · A personal library and reading tracker · Book data courtesy of
    <a href="https://books.google.com" rel="noopener noreferrer" target="_blank">Google Books</a> and
    <a href="https://openlibrary.org" rel="noopener noreferrer" target="_blank">Open Library</a>.
</footer>
