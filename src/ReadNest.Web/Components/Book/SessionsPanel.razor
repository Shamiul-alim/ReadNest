@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@using ReadNest.Application.Reading
@inject ReadingSessionService Sessions
@inject LibraryService Library

<section class="rn-card" aria-labelledby="sessions-heading">
    <div class="rn-flex rn-between mb-2">
        <h2 class="rn-card-title rn-mb-0" id="sessions-heading"><Icon Name="clock" /> Reading sessions</h2>
        <button type="button" class="rn-btn rn-btn-secondary rn-btn-sm" @onclick="OpenNew"><Icon Name="plus" /> Log a session</button>
    </div>

    @if (_error is not null)
    {
        <ErrorAlert Message="@_error" OnRetry="LoadSessionsAsync" />
    }
    else if (_sessions is null)
    {
        <LoadingIndicator />
    }
    else if (_sessions.Items.Count == 0)
    {
        <p class="rn-subtle rn-mb-0">No sessions yet. Log one to track pages, time and reflections — it also keeps your streak going.</p>
    }
    else
    {
        <div class="rn-list">
            @foreach (var session in _sessions.Items)
            {
                <div class="rn-list-item" @key="session.Id">
                    <div class="rn-list-body">
                        <div class="rn-flex rn-flex-wrap">
                            <strong>@session.ReadOn.ToString("ddd, d MMM yyyy")</strong>
                            <span class="rn-chip">p. @session.StartPage–@session.EndPage</span>
                            <span class="rn-subtle">@session.PagesRead.ToString("N0") pages@(session.DurationMinutes > 0 ? " · " + session.DurationMinutes + " min" : "")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(session.Reflection))
                        {
                            <div class="pre-wrap rn-muted mt-1">@session.Reflection</div>
                        }
                    </div>
                    <div class="rn-note-actions">
                        <button type="button" class="rn-btn rn-btn-ghost rn-btn-icon" aria-label="Edit session" @onclick="() => OpenEdit(session)"><Icon Name="pen" /></button>
                        <button type="button" class="rn-btn rn-btn-danger-ghost rn-btn-icon" aria-label="Delete session" @onclick="() => DeleteAsync(session)"><Icon Name="trash" /></button>
                    </div>
                </div>
            }
        </div>
        @if (_sessions.TotalCount > _sessions.Items.Count)
        {
            <a class="rn-subtle" href="@("history?entry=" + Entry.Id)">See all @_sessions.TotalCount sessions</a>
        }
    }
</section>

<Modal Title="@(_editingId is null ? "Log a reading session" : "Edit reading session")" @bind-Open="_open">
    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="rn-form">
        <DataAnnotationsValidator />
        <div class="rn-form-row">
            <div class="rn-field">
                <label class="rn-label" for="session-date">Date</label>
                <InputDate id="session-date" class="rn-input" @bind-Value="_form.ReadOn" />
                <ValidationMessage For="() => _form.ReadOn" />
            </div>
            <div class="rn-field">
                <label class="rn-label" for="session-minutes">Minutes</label>
                <InputNumber id="session-minutes" class="rn-input" @bind-Value="_form.DurationMinutes" min="0" max="1440" />
                <ValidationMessage For="() => _form.DurationMinutes" />
            </div>
        </div>
        <div class="rn-form-row">
            <div class="rn-field">
                <label class="rn-label" for="session-start">From page</label>
                <InputNumber id="session-start" class="rn-input" @bind-Value="_form.StartPage" min="0" />
                <ValidationMessage For="() => _form.StartPage" />
            </div>
            <div class="rn-field">
                <label class="rn-label" for="session-end">To page</label>
                <InputNumber id="session-end" class="rn-input" @bind-Value="_form.EndPage" min="0" max="@(Entry.TotalPages ?? 100000)" />
                <ValidationMessage For="() => _form.EndPage" />
            </div>
        </div>
        <p class="rn-hint rn-mb-0">
            Pages read: <strong>@Math.Max(0, _form.EndPage - _form.StartPage).ToString("N0")</strong>
            @if (Entry.TotalPages is { } total)
            {
                <span> · this edition has @total.ToString("N0") pages</span>
            }
        </p>
        <div class="rn-field">
            <label class="rn-label" for="session-reflection">Reflection <span class="rn-hint">(optional, private)</span></label>
            <InputTextArea id="session-reflection" class="rn-textarea" @bind-Value="_form.Reflection" maxlength="2000" />
            <ValidationMessage For="() => _form.Reflection" />
        </div>
        <div class="rn-form-actions">
            <button type="button" class="rn-btn rn-btn-secondary" @onclick="() => _open = false">Cancel</button>
            <button type="submit" class="rn-btn rn-btn-primary" disabled="@IsBusy">Save session</button>
        </div>
    </EditForm>
</Modal>

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter, EditorRequired] public LibraryEntryDetailsDto Entry { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private PagedResult<ReadingSessionDto>? _sessions;
    private string? _error;
    private bool _open;
    private Guid? _editingId;
    private SessionFormModel _form = new();
    private ConfirmDialog _confirm = default!;
    private Guid _loadedFor;
    private DateTime _loadedVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor != Entry.Id || _loadedVersion != Entry.UpdatedAtUtc)
        {
            _loadedFor = Entry.Id;
            _loadedVersion = Entry.UpdatedAtUtc;
            await LoadSessionsAsync();
        }
    }

    private async Task LoadSessionsAsync()
    {
        _error = await LoadAsync(async () =>
            _sessions = await Sessions.GetHistoryAsync(UserId, new HistoryQuery(EntryId: Entry.Id, Page: 1, PageSize: 10), ComponentToken));
    }

    private async Task OpenNew()
    {
        _editingId = null;
        _form = new SessionFormModel
        {
            ReadOn = await Library.GetTodayAsync(UserId, ComponentToken),
            StartPage = Entry.CurrentPage,
            EndPage = Entry.CurrentPage,
        };
        _open = true;
    }

    private void OpenEdit(ReadingSessionDto session)
    {
        _editingId = session.Id;
        _form = new SessionFormModel
        {
            ReadOn = session.ReadOn,
            StartPage = session.StartPage,
            EndPage = session.EndPage,
            DurationMinutes = session.DurationMinutes,
            Reflection = session.Reflection,
        };
        _open = true;
    }

    private async Task SaveAsync()
    {
        var request = new SessionRequest(_form.ReadOn, _form.StartPage, _form.EndPage, _form.DurationMinutes, _form.Reflection);
        var ok = await RunAsync(async () =>
        {
            if (_editingId is { } id)
            {
                await Sessions.UpdateAsync(UserId, id, request, ComponentToken);
            }
            else
            {
                await Sessions.LogAsync(UserId, Entry.Id, request, ComponentToken);
            }
        }, _editingId is null ? "Session recorded." : "Session updated.");

        if (ok)
        {
            _open = false;
            await LoadSessionsAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task DeleteAsync(ReadingSessionDto session)
    {
        if (!await _confirm.ConfirmAsync("Delete session?", $"The session on {session.ReadOn:d MMM yyyy} ({session.PagesRead} pages) will be removed from your history and statistics.", "Delete"))
        {
            return;
        }

        if (await RunAsync(() => Sessions.DeleteAsync(UserId, session.Id, ComponentToken), "Session deleted."))
        {
            await LoadSessionsAsync();
            await OnChanged.InvokeAsync();
        }
    }
}
