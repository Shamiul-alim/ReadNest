@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@using ReadNest.Application.Notes
@inject NoteService Notes

<section class="rn-card" aria-labelledby="notes-heading">
    <div class="rn-flex rn-between mb-2">
        <h2 class="rn-card-title rn-mb-0" id="notes-heading"><Icon Name="pen" /> Notes &amp; quotes</h2>
        <span class="rn-chip"><Icon Name="lock" /> Private</span>
    </div>

    <EditForm Model="_newNote" OnValidSubmit="CreateAsync" class="rn-form mb-3">
        <DataAnnotationsValidator />
        <NoteFields Model="_newNote" IdPrefix="new-note" />
        <div class="rn-form-actions">
            <button type="submit" class="rn-btn rn-btn-primary" disabled="@IsBusy"><Icon Name="plus" /> Save note</button>
        </div>
    </EditForm>

    @if (_error is not null)
    {
        <ErrorAlert Message="@_error" OnRetry="LoadNotesAsync" />
    }
    else if (_notes is null)
    {
        <LoadingIndicator />
    }
    else if (_notes.Items.Count == 0)
    {
        <p class="rn-subtle rn-mb-0">Capture quotes, key takeaways, lessons and action items as you read. Only you can see them.</p>
    }
    else
    {
        @foreach (var note in _notes.Items)
        {
            <NoteCard Note="note" OnEdit="() => OpenEdit(note)" OnDelete="() => DeleteAsync(note)" ShowBook="false" @key="note.Id" />
        }
        @if (_notes.TotalCount > _notes.Items.Count)
        {
            <a class="rn-subtle d-block mt-2" href="@("notes?entry=" + Entry.Id)">See all @_notes.TotalCount notes</a>
        }
    }
</section>

<Modal Title="Edit note" @bind-Open="_editOpen">
    <EditForm Model="_editNote" OnValidSubmit="UpdateAsync" class="rn-form">
        <DataAnnotationsValidator />
        <NoteFields Model="_editNote" IdPrefix="edit-note" />
        <div class="rn-form-actions">
            <button type="button" class="rn-btn rn-btn-secondary" @onclick="() => _editOpen = false">Cancel</button>
            <button type="submit" class="rn-btn rn-btn-primary" disabled="@IsBusy">Save changes</button>
        </div>
    </EditForm>
</Modal>

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter, EditorRequired] public LibraryEntryDetailsDto Entry { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private PagedResult<NoteDto>? _notes;
    private string? _error;
    private NoteFormModel _newNote = new();
    private NoteFormModel _editNote = new();
    private Guid? _editingId;
    private bool _editOpen;
    private ConfirmDialog _confirm = default!;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor != Entry.Id)
        {
            _loadedFor = Entry.Id;
            await LoadNotesAsync();
        }
    }

    private async Task LoadNotesAsync()
    {
        _error = await LoadAsync(async () => _notes = await Notes.SearchAsync(UserId, new NoteQuery(EntryId: Entry.Id, PageSize: 20), ComponentToken));
    }

    private async Task CreateAsync()
    {
        var request = new NoteRequest(_newNote.Type, _newNote.Content, _newNote.PageNumber, _newNote.Chapter);
        if (await RunAsync(() => Notes.CreateAsync(UserId, Entry.Id, request, ComponentToken), "Note saved."))
        {
            _newNote = new NoteFormModel { Type = _newNote.Type };
            await LoadNotesAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private void OpenEdit(NoteDto note)
    {
        _editingId = note.Id;
        _editNote = new NoteFormModel { Type = note.Type, Content = note.Content, PageNumber = note.PageNumber, Chapter = note.Chapter };
        _editOpen = true;
    }

    private async Task UpdateAsync()
    {
        if (_editingId is not { } id)
        {
            return;
        }

        var request = new NoteRequest(_editNote.Type, _editNote.Content, _editNote.PageNumber, _editNote.Chapter);
        if (await RunAsync(() => Notes.UpdateAsync(UserId, id, request, ComponentToken), "Note updated."))
        {
            _editOpen = false;
            await LoadNotesAsync();
        }
    }

    private async Task DeleteAsync(NoteDto note)
    {
        if (await _confirm.ConfirmAsync("Delete note?", "This note will be permanently deleted.", "Delete")
            && await RunAsync(() => Notes.DeleteAsync(UserId, note.Id, ComponentToken), "Note deleted."))
        {
            await LoadNotesAsync();
            await OnChanged.InvokeAsync();
        }
    }
}
