@inherits ReadNestComponentBase
@using ReadNest.Application.Library
@inject LibraryService Library

<section class="rn-card" aria-labelledby="reading-heading">
    <h2 class="rn-card-title" id="reading-heading"><Icon Name="book" /> Your reading</h2>

    <div class="rn-form-row mb-3">
        <div class="rn-field">
            <label class="rn-label" for="entry-status">Status</label>
            <select id="entry-status" class="rn-select" value="@Entry.Status" disabled="@IsBusy" @onchange="OnStatusSelectedAsync" @key="_statusRenderKey">
                @foreach (var status in Enum.GetValues<ReadingStatus>())
                {
                    <option value="@status">@status.ToDisplayName()</option>
                }
            </select>
        </div>
        <div class="rn-field" style="justify-content:flex-end">
            <button type="button" class="rn-btn @(Entry.IsFavorite ? "rn-btn-danger-ghost" : "rn-btn-secondary")" aria-pressed="@(Entry.IsFavorite ? "true" : "false")" disabled="@IsBusy" @onclick="ToggleFavoriteAsync">
                <Icon Name="heart" /> @(Entry.IsFavorite ? "Favourite" : "Mark as favourite")
            </button>
        </div>
    </div>

    <ProgressBar CurrentPage="Entry.CurrentPage" TotalPages="Entry.TotalPages" />

    <EditForm Model="_progress" OnValidSubmit="SaveProgressAsync" class="rn-form mt-3">
        <DataAnnotationsValidator />
        <div class="rn-form-row">
            <div class="rn-field">
                <label class="rn-label" for="progress-page">Current page</label>
                <InputNumber id="progress-page" class="rn-input" @bind-Value="_progress.CurrentPage" min="0" max="@(Entry.TotalPages ?? 100000)" />
                <ValidationMessage For="() => _progress.CurrentPage" />
            </div>
            <div class="rn-field">
                <label class="rn-label" for="progress-minutes">Minutes read <span class="rn-hint">(optional)</span></label>
                <InputNumber id="progress-minutes" class="rn-input" @bind-Value="_progress.DurationMinutes" min="0" max="1440" />
                <ValidationMessage For="() => _progress.DurationMinutes" />
            </div>
        </div>
        <label class="rn-check">
            <InputCheckbox @bind-Value="_progress.RecordSession" />
            <span>Record the pages since page @Entry.CurrentPage.ToString("N0") as today's reading session</span>
        </label>
        <div class="rn-form-actions">
            @if (Entry.Status != ReadingStatus.Read)
            {
                <button type="button" class="rn-btn rn-btn-secondary" disabled="@IsBusy" @onclick="OpenFinishDialog"><Icon Name="check-circle" /> Mark as finished</button>
            }
            <button type="submit" class="rn-btn rn-btn-primary" disabled="@IsBusy">Update progress</button>
        </div>
    </EditForm>

    <hr class="rn-divider" />
    <dl class="rn-facts rn-mb-0">
        <div class="rn-fact"><dt>Started</dt><dd>@Format(Entry.StartedOn)</dd></div>
        <div class="rn-fact"><dt>Finished</dt><dd>@(Entry.Status == ReadingStatus.Read ? (Entry.CompletedOn is null ? "Date unknown" : Format(Entry.CompletedOn)) : "—")</dd></div>
        <div class="rn-fact"><dt>Last read</dt><dd>@Format(Entry.LastReadOn)</dd></div>
        <div class="rn-fact"><dt>Added</dt><dd>@Entry.AddedAtUtc.ToString("d MMM yyyy")</dd></div>
    </dl>
    @if (!string.IsNullOrWhiteSpace(Entry.PrivateNotes))
    {
        <div class="rn-note mt-3"><div class="rn-note-head"><Icon Name="lock" /> Private notes</div><div class="rn-note-content">@Entry.PrivateNotes</div></div>
    }
    <div class="rn-flex rn-flex-wrap mt-3">
        <button type="button" class="rn-btn rn-btn-ghost rn-btn-sm" @onclick="OpenDetails"><Icon Name="pen" /> Edit dates, pages &amp; private notes</button>
        <button type="button" class="rn-btn rn-btn-danger-ghost rn-btn-sm ms-auto" disabled="@IsBusy" @onclick="RemoveAsync"><Icon Name="trash" /> Remove from library</button>
    </div>
</section>

<Modal Title="Mark as finished" @bind-Open="_finishOpen">
    <ChildContent>
        <div class="rn-field">
            <label class="rn-label" for="finish-date">Date you finished</label>
            <InputDate id="finish-date" class="rn-input" @bind-Value="_finishDate" max="@_today?.ToString("yyyy-MM-dd")" />
            <span class="rn-hint">Counts toward the reading goal of that year.</span>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="rn-btn rn-btn-secondary" @onclick="() => _finishOpen = false">Cancel</button>
        <button type="button" class="rn-btn rn-btn-primary" disabled="@IsBusy" @onclick="FinishAsync">Mark as read</button>
    </Footer>
</Modal>

<Modal Title="Reading details" @bind-Open="_detailsOpen">
    <EditForm Model="_details" OnValidSubmit="SaveDetailsAsync" class="rn-form">
        <DataAnnotationsValidator />
        <div class="rn-form-row">
            <div class="rn-field">
                <label class="rn-label" for="details-total">Total pages in your edition</label>
                <InputNumber id="details-total" class="rn-input" @bind-Value="_details.TotalPages" />
                <ValidationMessage For="() => _details.TotalPages" />
            </div>
            <div class="rn-field">
                <label class="rn-label" for="details-start">Started on</label>
                <InputDate id="details-start" class="rn-input" @bind-Value="_details.StartedOn" />
            </div>
            @if (Entry.Status == ReadingStatus.Read)
            {
                <div class="rn-field">
                    <label class="rn-label" for="details-end">Finished on</label>
                    <InputDate id="details-end" class="rn-input" @bind-Value="_details.CompletedOn" />
                    <ValidationMessage For="() => _details.CompletedOn" />
                </div>
            }
        </div>
        <div class="rn-field">
            <label class="rn-label" for="details-notes">Private notes <span class="rn-hint">(only you can see these)</span></label>
            <InputTextArea id="details-notes" class="rn-textarea" @bind-Value="_details.PrivateNotes" maxlength="4000" />
            <ValidationMessage For="() => _details.PrivateNotes" />
        </div>
        <div class="rn-form-actions">
            <button type="button" class="rn-btn rn-btn-secondary" @onclick="() => _detailsOpen = false">Cancel</button>
            <button type="submit" class="rn-btn rn-btn-primary" disabled="@IsBusy">Save</button>
        </div>
    </EditForm>
</Modal>

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter, EditorRequired] public LibraryEntryDetailsDto Entry { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnRemoved { get; set; }

    private ProgressFormModel _progress = new();
    private EntryDetailsFormModel _details = new();
    private ConfirmDialog _confirm = default!;
    private bool _finishOpen;
    private bool _detailsOpen;
    private DateOnly? _finishDate;
    private DateOnly? _today;
    private int _statusRenderKey;
    private Guid _loadedFor;
    private DateTime _loadedVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor != Entry.Id || _loadedVersion != Entry.UpdatedAtUtc)
        {
            _loadedFor = Entry.Id;
            _loadedVersion = Entry.UpdatedAtUtc;
            _progress = new ProgressFormModel { CurrentPage = Entry.CurrentPage, RecordSession = true };
        }

        _today ??= await Library.GetTodayAsync(UserId, ComponentToken);
    }

    private async Task OnStatusSelectedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<ReadingStatus>(e.Value?.ToString(), out var status) || status == Entry.Status)
        {
            return;
        }

        if (status == ReadingStatus.Read)
        {
            OpenFinishDialog();
            return;
        }

        if (await RunAsync(() => Library.UpdateStatusAsync(UserId, Entry.Id, new UpdateStatusRequest(status), ComponentToken), $"Moved to {status.ToDisplayName()}."))
        {
            await OnChanged.InvokeAsync();
        }
    }

    private void OpenFinishDialog()
    {
        // Re-create the status select so it shows the saved status if the dialog is cancelled.
        _statusRenderKey++;
        _finishDate = _today;
        _finishOpen = true;
    }

    private async Task FinishAsync()
    {
        if (_finishDate is null)
        {
            Toasts.Error("Choose the date you finished the book.");
            return;
        }

        if (await RunAsync(() => Library.UpdateStatusAsync(UserId, Entry.Id, new UpdateStatusRequest(ReadingStatus.Read, _finishDate), ComponentToken), "Marked as read. Congratulations!"))
        {
            _finishOpen = false;
            await OnChanged.InvokeAsync();
        }
    }

    private async Task SaveProgressAsync()
    {
        var request = new UpdateProgressRequest(_progress.CurrentPage, _progress.RecordSession, _progress.DurationMinutes);
        if (await RunAsync(() => Library.UpdateProgressAsync(UserId, Entry.Id, request, ComponentToken), "Progress updated."))
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        var target = !Entry.IsFavorite;
        if (await RunAsync(() => Library.SetFavoriteAsync(UserId, Entry.Id, target, ComponentToken), target ? "Added to favourites." : "Removed from favourites."))
        {
            await OnChanged.InvokeAsync();
        }
    }

    private void OpenDetails()
    {
        _details = new EntryDetailsFormModel
        {
            TotalPages = Entry.TotalPages,
            StartedOn = Entry.StartedOn,
            CompletedOn = Entry.CompletedOn,
            PrivateNotes = Entry.PrivateNotes,
        };
        _detailsOpen = true;
    }

    private async Task SaveDetailsAsync()
    {
        var request = new UpdateEntryDetailsRequest(_details.TotalPages, _details.StartedOn, Entry.Status == ReadingStatus.Read ? _details.CompletedOn : null, _details.PrivateNotes);
        if (await RunAsync(() => Library.UpdateDetailsAsync(UserId, Entry.Id, request, ComponentToken), "Details saved."))
        {
            _detailsOpen = false;
            await OnChanged.InvokeAsync();
        }
    }

    private async Task RemoveAsync()
    {
        RemovalImpactDto? impact = null;
        if (!await RunAsync(async () => impact = await Library.GetRemovalImpactAsync(UserId, Entry.Id, ComponentToken)) || impact is null)
        {
            return;
        }

        if (impact.HasOutstandingLoan)
        {
            Toasts.Error("This book is currently lent out. Mark the loan as returned before removing it.");
            return;
        }

        var details = new List<string>();
        if (impact.Sessions > 0) details.Add($"{impact.Sessions} reading session(s)");
        if (impact.Notes > 0) details.Add($"{impact.Notes} note(s) and quote(s)");
        if (impact.HasReview) details.Add("your review");
        if (impact.Loans > 0) details.Add($"{impact.Loans} past loan record(s)");
        if (impact.Shelves > 0) details.Add($"its place on {impact.Shelves} shelf/shelves");

        var message = details.Count == 0
            ? $"“{Entry.Title}” will be removed from your library."
            : $"“{Entry.Title}” will be removed from your library together with:";
        if (await _confirm.ConfirmAsync("Remove from library?", message, "Remove book", danger: true, details: details.Count == 0 ? null : details))
        {
            if (await RunAsync(() => Library.RemoveAsync(UserId, Entry.Id, ComponentToken), "Removed from your library."))
            {
                await OnRemoved.InvokeAsync();
            }
        }
    }

    private static string Format(DateOnly? date) => date?.ToString("d MMM yyyy") ?? "—";
}
