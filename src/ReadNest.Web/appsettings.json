{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Identity": {
    "RequireConfirmedAccount": false
  },
  "Features": {
    "PublicReviews": true
  },
  "Catalog": {
    "ProviderOrder": [ "GoogleBooks", "OpenLibrary" ],
    "SearchCacheMinutes": 15,
    "BookCacheMinutes": 120,
    "GoogleBooks": {
      "Enabled": true,
      "BaseUrl": "https://www.googleapis.com/books/v1/",
      "ApiKey": ""
    },
    "OpenLibrary": {
      "Enabled": true,
      "BaseUrl": "https://openlibrary.org/",
      "CoversBaseUrl": "https://covers.openlibrary.org/",
      "ContactEmail": ""
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Storage": {
    "RootPath": "App_Data/storage"
  },
  "Uploads": {
    "ProfilePhotoMaxBytes": 5242880,
    "ReadingFileMaxBytes": 52428800
  },
  "ReadingSources": {
    "GoogleBooksEnabled": true,
    "OpenLibraryEnabled": true,
    "GutenbergEnabled": true,
    "GutendexBaseUrl": "https://gutendex.com/"
  },
  "ReverseProxy": {
    "ForwardHeaders": false
  },
  "Https": {
    "Redirect": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
