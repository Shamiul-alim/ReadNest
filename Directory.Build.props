<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515/CA1848/CA1062 etc. are noisy for an application (not a reusable library).
         CA1862 is suppressed because StringComparison overloads cannot be translated to SQL by EF Core. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1062;CA1716;CA1711;CA1724;CA1056;CA1054;CA1055;CA2007;CA1819;CA1002;CA1305;CA1307;CA1309;CA1311;CA1304;CA1863;CA1031;CA1032;CA1064;CA2227;CA1308;CA1812;CA5394;CA1861;CA1860;CA1866;CA1865;CA1847;CA1310;CA2201;CA1822;CA1849;CA1859;CA2016;CA1825;CA1806;CA1720;CA1034;CA1862;CA1000;CA1873</NoWarn>
  </PropertyGroup>
</Project>
