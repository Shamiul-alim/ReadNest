# Copy to `.env` (git-ignored) and adjust. Used by docker-compose.yml.

# --- PostgreSQL (required) ---
POSTGRES_DB=readnest
POSTGRES_USER=readnest
# Local development only. Use a strong, unique password anywhere else.
POSTGRES_PASSWORD=readnest_dev_password
POSTGRES_PORT=5433

# --- Application container (optional, `docker compose --profile app up`) ---
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# --- Book catalogue (optional) ---
# Google Books works without a key at a lower anonymous quota.
GOOGLE_BOOKS_API_KEY=
# Open Library asks API clients to identify themselves; an email or URL is included in the User-Agent.
OPEN_LIBRARY_CONTACT_EMAIL=
